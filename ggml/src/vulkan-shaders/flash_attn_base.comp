#if defined(DATA_A_Q4_K)
#define BLOCK_BYTE_SIZE 144

// Helper: extract uint8 from packed uint16 scales array
uint q4k_scale_byte(uint ib, uint idx, uint a_offset, uint binding_idx) {
    uint word = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].scales[idx >> 1]);
    return (word >> (8 * (idx & 1))) & 0xFF;
}

vec4 dequantize4(uint ib, uint iqs, uint a_offset, uint binding_idx) {
    float dall = float(kv_packed[binding_idx].data_packed16[a_offset + ib].d.x);
    float dmin = float(kv_packed[binding_idx].data_packed16[a_offset + ib].d.y);

    // Sub-block index (0..7) — each vec4 stays within one 32-element sub-block
    uint sb = iqs / 32;
    uint is = sb & 0xFE;

    // Extract 6-bit scale and min using the Q4_K packing scheme
    uint scidx0, scidx1, mbidx0, mbidx1;
    if ((sb & 1) == 0) {
        scidx0 = (is < 4) ? is     : (is + 4);
        scidx1 = (is < 4) ? is     : (is - 4);
        mbidx0 = is + 4;
        mbidx1 = (is < 4) ? is + 4 : is;
    } else {
        uint is1 = is + 1;
        scidx0 = (is < 4) ? is1     : (is1 + 4);
        scidx1 = (is < 4) ? is1     : (is1 - 4);
        mbidx0 = is + 5;
        mbidx1 = (is < 4) ? is + 5  : is + 1;
    }
    uint scmask1  = (is < 4) ? 0x30 : 0xC0;
    uint scshift1 = (is < 4) ? 0    : 2;
    uint mbmask0  = (is < 4) ? 0x0F : 0xF0;
    uint mbshift0 = (is < 4) ? 0    : 4;
    uint mbmask1  = (is < 4) ? 0x30 : 0xC0;
    uint mbshift1 = (is < 4) ? 0    : 2;

    float sc = float((q4k_scale_byte(ib, scidx0, a_offset, binding_idx) & 0xF) |
                     ((q4k_scale_byte(ib, scidx1, a_offset, binding_idx) & scmask1) >> scshift1));
    float mb = float(((q4k_scale_byte(ib, mbidx0, a_offset, binding_idx) & mbmask0) >> mbshift0) |
                     ((q4k_scale_byte(ib, mbidx1, a_offset, binding_idx) & mbmask1) >> mbshift1));

    float d = dall * sc;
    float m = dmin * mb;

    // Extract 4 quantized nibbles from qs[64] (packed uint16_t)
    uint g = iqs / 64;
    uint h = (iqs / 32) & 1;
    uint idx = iqs % 32;
    uint qs_base = 32 * g + idx;  // always even (iqs is 4-aligned)

    uint q16_0 = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qs[qs_base / 2]);
    uint q16_1 = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qs[qs_base / 2 + 1]);

    vec4 qv;
    if (h == 0) {
        qv = vec4(q16_0 & 0xF, (q16_0 >> 8) & 0xF, q16_1 & 0xF, (q16_1 >> 8) & 0xF);
    } else {
        qv = vec4((q16_0 >> 4) & 0xF, (q16_0 >> 12) & 0xF, (q16_1 >> 4) & 0xF, (q16_1 >> 12) & 0xF);
    }

    return d * qv - vec4(m);
}
#endif

#if defined(DATA_A_Q5_K)
#define BLOCK_BYTE_SIZE 176

// Reuse scale byte helper (same packed scale layout as Q4_K)
uint q5k_scale_byte(uint ib, uint idx, uint a_offset, uint binding_idx) {
    uint word = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].scales[idx >> 1]);
    return (word >> (8 * (idx & 1))) & 0xFF;
}

vec4 dequantize4(uint ib, uint iqs, uint a_offset, uint binding_idx) {
    float dall = float(kv_packed[binding_idx].data_packed16[a_offset + ib].d.x);
    float dmin = float(kv_packed[binding_idx].data_packed16[a_offset + ib].d.y);

    // Sub-block scale extraction (identical to Q4_K)
    uint sb = iqs / 32;
    uint is = sb & 0xFE;

    uint scidx0, scidx1, mbidx0, mbidx1;
    if ((sb & 1) == 0) {
        scidx0 = (is < 4) ? is     : (is + 4);
        scidx1 = (is < 4) ? is     : (is - 4);
        mbidx0 = is + 4;
        mbidx1 = (is < 4) ? is + 4 : is;
    } else {
        uint is1 = is + 1;
        scidx0 = (is < 4) ? is1     : (is1 + 4);
        scidx1 = (is < 4) ? is1     : (is1 - 4);
        mbidx0 = is + 5;
        mbidx1 = (is < 4) ? is + 5  : is + 1;
    }
    uint scmask1  = (is < 4) ? 0x30 : 0xC0;
    uint scshift1 = (is < 4) ? 0    : 2;
    uint mbmask0  = (is < 4) ? 0x0F : 0xF0;
    uint mbshift0 = (is < 4) ? 0    : 4;
    uint mbmask1  = (is < 4) ? 0x30 : 0xC0;
    uint mbshift1 = (is < 4) ? 0    : 2;

    float sc = float((q5k_scale_byte(ib, scidx0, a_offset, binding_idx) & 0xF) |
                     ((q5k_scale_byte(ib, scidx1, a_offset, binding_idx) & scmask1) >> scshift1));
    float mb = float(((q5k_scale_byte(ib, mbidx0, a_offset, binding_idx) & mbmask0) >> mbshift0) |
                     ((q5k_scale_byte(ib, mbidx1, a_offset, binding_idx) & mbmask1) >> mbshift1));

    float d = dall * sc;
    float m = dmin * mb;

    // Extract 4 base nibbles from qs (same layout as Q4_K)
    uint g = iqs / 64;
    uint h = (iqs / 32) & 1;
    uint idx = iqs % 32;
    uint qs_base = 32 * g + idx;

    uint q16_0 = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qs[qs_base / 2]);
    uint q16_1 = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qs[qs_base / 2 + 1]);

    vec4 qv;
    if (h == 0) {
        qv = vec4(q16_0 & 0xF, (q16_0 >> 8) & 0xF, q16_1 & 0xF, (q16_1 >> 8) & 0xF);
    } else {
        qv = vec4((q16_0 >> 4) & 0xF, (q16_0 >> 12) & 0xF, (q16_1 >> 4) & 0xF, (q16_1 >> 12) & 0xF);
    }

    // Q5_K 5th bit: qh[32] bytes packed as qh[16] uint16_t
    // Bit position = 2*group + half, byte index = pos_in_subblock
    uint bit = 2 * g + h;
    uint qh_base = idx;  // 0..31, always even (4-aligned iqs)

    uint qh16_0 = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qh[qh_base / 2]);
    uint qh16_1 = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qh[qh_base / 2 + 1]);

    vec4 hv = vec4(
        float((qh16_0 >> bit) & 1),
        float(((qh16_0 >> 8) >> bit) & 1),
        float((qh16_1 >> bit) & 1),
        float(((qh16_1 >> 8) >> bit) & 1)
    );

    return d * (qv + 16.0 * hv) - vec4(m);
}
#endif

#if defined(DATA_A_Q6_K)
#define BLOCK_BYTE_SIZE 210

vec4 dequantize4(uint ib, uint iqs, uint a_offset, uint binding_idx) {
    float d = float(kv_packed[binding_idx].data_packed16[a_offset + ib].d);

    // Q6_K: 4 quarters of 64, each quarter has layers at offsets 0, 32, 64, 96
    uint ip = iqs / 128;            // 0 or 1
    uint local_pos = iqs - 128*ip;  // 0..127
    uint layer = local_pos / 32;    // 0..3
    uint within = local_pos % 32;   // 0..31 (4-aligned)

    // Scale: 16 int8 scales, one per 16 elements
    uint scale_idx = iqs / 16;
    float sc = float(kv_packed[binding_idx].data_packed16[a_offset + ib].scales[scale_idx]);

    // ql: low 4 bits from ql[64] uint16_t (128 bytes)
    // layers 0,1 use low nibble; layers 2,3 use high nibble (of same bytes)
    uint ql_byte_base = 64*ip + 32*(layer & 1) + within;
    uint ql_shift = (layer >= 2) ? 4 : 0;

    uint ql16_0 = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].ql[ql_byte_base / 2]);
    uint ql16_1 = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].ql[ql_byte_base / 2 + 1]);

    vec4 ql_vals = vec4(
        (ql16_0 >> ql_shift) & 0xF,
        ((ql16_0 >> 8) >> ql_shift) & 0xF,
        (ql16_1 >> ql_shift) & 0xF,
        ((ql16_1 >> 8) >> ql_shift) & 0xF
    );

    // qh: high 2 bits from qh[32] uint16_t (64 bytes)
    uint qh_byte_base = 32*ip + within;
    uint qh_shift = 2*layer;

    uint qh16_0 = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qh[qh_byte_base / 2]);
    uint qh16_1 = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qh[qh_byte_base / 2 + 1]);

    vec4 qh_vals = vec4(
        float((qh16_0 >> qh_shift) & 3),
        float(((qh16_0 >> 8) >> qh_shift) & 3),
        float((qh16_1 >> qh_shift) & 3),
        float(((qh16_1 >> 8) >> qh_shift) & 3)
    );

    return d * sc * (ql_vals + 16.0 * qh_vals - vec4(32.0));
}
#endif

#define CEIL_DIV(a, b) (((a) + (b) - 1) / (b))


// Store column zero. This is used to save per-row m and L values for split_k.
ACC_TYPE perElemOpStoreCol0(const in uint32_t r, const in uint32_t c, const in ACC_TYPE elem, const in uint32_t o_offset, const in uint32_t iq2, const in uint32_t N)
{
    if (r < N && c == 0) {
        uint32_t offset = iq2 + r;
        data_o[o_offset + offset] = D_TYPE(elem);
    }
    return elem;
}

// Load the slope matrix, indexed by Q's dimension 2.
ACC_TYPE perElemOpComputeSlope(const in uint32_t r, const in uint32_t c, const in ACC_TYPE elem, const in uint32_t iq2)
{
    const uint32_t h = iq2 + (r % p.gqa_ratio);

    uint32_t n_head_log2 = p.mask_n_head_log2 & N_LOG2_MASK;

    const ACC_TYPE base = ACC_TYPE(h < n_head_log2 ? p.m0 : p.m1);
    const int      exph = int(h < n_head_log2 ? h + 1 : 2*(h - n_head_log2) + 1);

    return ACC_TYPE(pow(base, ACC_TYPE(exph)));
}

uint32_t i, N, KV, split_k_index, Tr, start_j, end_j,
         iq2, iq3, rk2, rk3, rv2, rv3, ik2, ik3, iv2, iv3,
         q_stride, k_stride, v_stride, m_stride;

void init_indices()
{
    N = p.N;
    KV = p.KV;

    i = gl_WorkGroupID.x;
    split_k_index = 0;

    if (p.k_num > 1) {
        i = 0;
        split_k_index = gl_WorkGroupID.x;
    }

    Tr = CEIL_DIV(N, Br);

    start_j = split_k_index * p.split_kv / Bc;
    end_j = CEIL_DIV(min(KV, (split_k_index + 1) * p.split_kv), Bc);

    // When not using grouped query attention, all rows share the same iq2, equal to gl_WorkGroupID.y.
    // When using grouped query attention, each workgroup does gqa_ratio consecutive values of iq2.
    iq2 = gl_WorkGroupID.y * p.gqa_ratio;
    iq3 = gl_WorkGroupID.z;

    // broadcast factors
    rk2 = p.neq2/p.nek2;
    rk3 = p.neq3/p.nek3;

    rv2 = p.neq2/p.nev2;
    rv3 = p.neq3/p.nev3;

    // k indices
    ik3 = iq3 / rk3;
    ik2 = iq2 / rk2;

    // v indices
    iv3 = iq3 / rv3;
    iv2 = iq2 / rv2;

    // nb?1 are already divided by the type size and are in units of elements.
    // When using grouped query attention, Q is indexed by iq2, so the stride
    // should be nb02 (which is in bytes).
    q_stride = p.gqa_ratio > 1 ? (p.nb02 / 4) : p.nb01;
    k_stride = p.nb11;
    v_stride = p.nb21;
    // When using grouped query attention, all rows use the same mask (stride 0).
    // "p.gqa_ratio >> 16" is just a roundabout way of writing zero
    // that prevents the compiler from folding the "&" through the select
    // and breaking the alignment detection.
    m_stride = (p.gqa_ratio > 1) ? (p.gqa_ratio >> 16) : KV;
}
