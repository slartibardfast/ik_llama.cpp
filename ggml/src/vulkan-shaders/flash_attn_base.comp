#if defined(DATA_A_Q5_0)
#define BLOCK_BYTE_SIZE 22

vec4 dequantize4(uint ib, uint iqs, uint a_offset, uint binding_idx) {
    float d = float(kv_packed[binding_idx].data_packed16[a_offset + ib].d);

    uint uint_qh = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qh[1]) << 16
                 | uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qh[0]);

    uint vui_lo = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qs[(iqs & 0xF) / 2 + 0]);
    uint vui_hi = uint(kv_packed[binding_idx].data_packed16[a_offset + ib].qs[(iqs & 0xF) / 2 + 1]);
    uint shift = (iqs & 0x10) >> 2;
    vui_lo >>= shift;
    vui_hi >>= shift;

    // qh bit i = 5th bit of value at position i (0..31)
    vec4 hi = vec4(
        float(int((uint_qh >> (iqs + 0)) & 1) << 4),
        float(int((uint_qh >> (iqs + 1)) & 1) << 4),
        float(int((uint_qh >> (iqs + 2)) & 1) << 4),
        float(int((uint_qh >> (iqs + 3)) & 1) << 4)
    );

    return d * (vec4((vui_lo & 0xF), ((vui_lo >> 8) & 0xF), (vui_hi & 0xF), ((vui_hi >> 8) & 0xF)) + hi - 16.0);
}
#endif

