#version 450

// GET_ROWS for TURBO_KV_4B: extract and dequantize rows via inverse RHT.
// One workgroup (= one subgroup) per 128-element block.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#include "types.comp"

#ifndef SUBGROUP_SIZE
#define SUBGROUP_SIZE 64
#endif

#include "turbo_kv_4b_rht.comp"

layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03;
    uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13;
    uint nb10; uint nb11; uint nb12; uint nb13;
    uint ne20; uint ne21; uint ne22; uint ne23;
    uint nb20; uint nb21; uint nb22; uint nb23;
    uint misalign_offsets;
    float param1; float param2; int param3;
} p;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_turbo_kv_4b data_a[];};
layout (binding = 1) readonly buffer B {int data_b[];};
layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};

void main() {
    const uint wg = gl_WorkGroupID.z * gl_NumWorkGroups.y * gl_NumWorkGroups.x
                   + gl_WorkGroupID.y * gl_NumWorkGroups.x
                   + gl_WorkGroupID.x;
    const uint blocks_per_row = p.ne00 / QUANT_K_TURBO_KV_4B;
    if (wg >= p.ne01 * blocks_per_row) return;

    const uint row = wg / blocks_per_row;
    const uint blk = wg % blocks_per_row;
    const uint src_row = data_b[row];
    const uint src_blk = src_row * blocks_per_row + blk;
    const uint tid = gl_SubgroupInvocationID;

    const float norm = unpackHalf2x16(uint(data_a[src_blk].norm)).x;
    const float inv_std = unpackHalf2x16(uint(data_a[src_blk].inv_std_fp16)).x;
    const float rcp_inv_std = 1.0 / max(inv_std, 1e-10);

#if SUBGROUP_SIZE >= 64
    float val0 = turbo_kv_unpack_byte(uint(data_a[src_blk].mse_indices[tid / 2]),      tid,      rcp_inv_std);
    float val1 = turbo_kv_unpack_byte(uint(data_a[src_blk].mse_indices[(tid + 64) / 2]), tid + 64, rcp_inv_std);

    turbo_kv_inverse_rht(val0, val1, tid, norm);

    const uint dst_base = (row * blocks_per_row + blk) * QUANT_K_TURBO_KV_4B;
    data_d[dst_base + tid]      = D_TYPE(val0);
    data_d[dst_base + tid + 64] = D_TYPE(val1);
#else
    float v0 = turbo_kv_unpack_byte(uint(data_a[src_blk].mse_indices[tid / 2]),        tid,      rcp_inv_std);
    float v1 = turbo_kv_unpack_byte(uint(data_a[src_blk].mse_indices[(tid + 32) / 2]), tid + 32, rcp_inv_std);
    float v2 = turbo_kv_unpack_byte(uint(data_a[src_blk].mse_indices[(tid + 64) / 2]), tid + 64, rcp_inv_std);
    float v3 = turbo_kv_unpack_byte(uint(data_a[src_blk].mse_indices[(tid + 96) / 2]), tid + 96, rcp_inv_std);

    turbo_kv_inverse_rht(v0, v1, v2, v3, tid, norm);

    const uint dst_base = (row * blocks_per_row + blk) * QUANT_K_TURBO_KV_4B;
    data_d[dst_base + tid]      = D_TYPE(v0);
    data_d[dst_base + tid + 32] = D_TYPE(v1);
    data_d[dst_base + tid + 64] = D_TYPE(v2);
    data_d[dst_base + tid + 96] = D_TYPE(v3);
#endif
}
