#version 450

// SSM_CONV — multi-sequence slow path (Paths C/D in PR #1251 CUDA).
//
// One workgroup per row. Each thread iterates ALL n_t tokens serially,
// reading the per-token sequence assignment from src3 and writing both
// the conv output (dst_x) and the new state (dst_state) for the
// assigned sequence. Handles recurrent dependencies (token t reads the
// state written at token t-1) and multi-target fanout (token t writes
// state to multiple seqs via sq[1..]).
//
// Compile variants:
//   NC4               — d_conv=4 unrolled (Mamba/SSM hot path)
//   HAS_MULTI_SEQ     — enables the multi-target fanout loop. When n_kv==1
//                       the loop body is never reached, so we compile it
//                       out for the n_kv==1 corner case.

#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer Src0 { float data_src0[]; };       // state [nc-1, nr, n_kv]
layout(binding = 1) readonly buffer Src1 { float data_src1[]; };       // x [nr, n_t]
layout(binding = 2) readonly buffer Src2 { float data_src2[]; };       // c [nc, nr]
layout(binding = 3) readonly buffer Src3 { int   data_src3[]; };       // sq [n_kv, n_t] i32
layout(binding = 4) buffer Dst { float data_dst[]; };                  // packed [conv_output | dst_state]

layout(push_constant) uniform PushConstants {
    uint nr;
    uint n_t;
    uint nc;
    uint n_kv;
    uint src0_s0;
    uint src0_s1;
    uint src0_s2;
    uint src1_s1;
    uint src3_s1;
    uint dst_state_offset;  // = nr * n_t (in floats)
} p;

void main() {
    const uint row = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (row >= p.nr) return;

    const uint c_base = row * p.nc;
#ifdef NC4
    const float c0 = data_src2[c_base + 0];
    const float c1 = data_src2[c_base + 1];
    const float c2 = data_src2[c_base + 2];
    const float c3 = data_src2[c_base + 3];
#endif

    for (uint t = 0; t < p.n_t; ++t) {
        const uint sq_base = t * p.src3_s1;
        const int seq0 = data_src3[sq_base + 0];

        // Skip invalid seq ids — matches CUDA `continue` semantics. Still
        // need to advance t.
        if (seq0 < 0 || uint(seq0) >= p.n_kv) continue;

        // state_row = dst_state[seq0, row, *] (nc consecutive floats)
        const uint state_row_base = p.dst_state_offset
                                    + uint(seq0) * p.nr * p.nc
                                    + row * p.nc;

#ifdef NC4
        // Source state: at t==0, read initial state from src0 (which has
        // nc-1=3 entries per row). At t>0, the previous iteration wrote
        // state_row[0..3]; the new state is shifted-in via state_row[1..3].
        float s0, s1, s2;
        if (t == 0) {
            const uint src_base = uint(seq0) * p.nr * 3 + row * 3;
            s0 = data_src0[src_base + 0];
            s1 = data_src0[src_base + 1];
            s2 = data_src0[src_base + 2];
        } else {
            // self-read: positions [1..3] of the state we wrote last iteration
            s0 = data_dst[state_row_base + 1];
            s1 = data_dst[state_row_base + 2];
            s2 = data_dst[state_row_base + 3];
        }

        const float x = data_src1[row + t * p.src1_s1];

        data_dst[state_row_base + 0] = s0;
        data_dst[state_row_base + 1] = s1;
        data_dst[state_row_base + 2] = s2;
        data_dst[state_row_base + 3] = x;

  #ifdef HAS_MULTI_SEQ
        // Multi-target fanout: copy the new state to additional seqs.
        for (uint i3 = 1; i3 < p.n_kv; ++i3) {
            const int seq = data_src3[sq_base + i3];
            if (seq < 0 || uint(seq) >= p.n_kv) break;
            const uint copy_base = p.dst_state_offset
                                   + uint(seq) * p.nr * p.nc
                                   + row * p.nc;
            data_dst[copy_base + 0] = s0;
            data_dst[copy_base + 1] = s1;
            data_dst[copy_base + 2] = s2;
            data_dst[copy_base + 3] = x;
        }
  #endif

        data_dst[row + t * p.nr] = s0 * c0 + s1 * c1 + s2 * c2 + x * c3;
#else
        // General nc path. Reads/writes nc state values per token.
        const uint src_base = uint(seq0) * p.nr * (p.nc - 1) + row * (p.nc - 1);

        // Build the new state for this token.
        // state_row[i0] = src_state_row[i0]  for i0 in [0, nc-1)
        // state_row[nc-1] = src1[row + t * src1_s1]
        for (uint i0 = 0; i0 < p.nc - 1; ++i0) {
            float v;
            if (t == 0) {
                v = data_src0[src_base + i0];
            } else {
                v = data_dst[state_row_base + 1 + i0];
            }
            data_dst[state_row_base + i0] = v;
        }
        const float x = data_src1[row + t * p.src1_s1];
        data_dst[state_row_base + p.nc - 1] = x;

  #ifdef HAS_MULTI_SEQ
        // Multi-target fanout
        for (uint i3 = 1; i3 < p.n_kv; ++i3) {
            const int seq = data_src3[sq_base + i3];
            if (seq < 0 || uint(seq) >= p.n_kv) break;
            const uint copy_base = p.dst_state_offset
                                   + uint(seq) * p.nr * p.nc
                                   + row * p.nc;
            for (uint i0 = 0; i0 < p.nc; ++i0) {
                data_dst[copy_base + i0] = data_dst[state_row_base + i0];
            }
        }
  #endif

        // Dot product
        float sum = 0.0;
        for (uint i0 = 0; i0 < p.nc; ++i0) {
            sum += data_dst[state_row_base + i0] * data_src2[c_base + i0];
        }
        data_dst[row + t * p.nr] = sum;
#endif
    }
}
