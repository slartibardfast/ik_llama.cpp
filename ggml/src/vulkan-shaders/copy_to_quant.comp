#version 450

#if RTE16
#extension GL_EXT_spirv_intrinsics : enable
spirv_execution_mode(capabilities = [4467], 4462, 16); // RoundingModeRTE, 16 bits
#endif // RTE16

#include "types.comp"

#if defined(SET_ROWS) && QUANT_K == 1
layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
const uint BLOCK_SIZE = 512;
#else
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
const uint BLOCK_SIZE = 32;
#endif

layout (binding = 0) readonly buffer S {float data_s[];};

#if defined(SET_ROWS)
#include "generic_binary_head.comp"
layout (binding = 1) readonly buffer C {uvec2 data_i[];};
layout (binding = 2) writeonly buffer Q {A_TYPE data_q[];};
#else
#include "generic_unary_head.comp"
layout (binding = 1) writeonly buffer Q {A_TYPE data_q[];};
#endif

#if defined(DATA_A_Q4_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    float vmax = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_0; ++j) {
        const float v = data_s[src_idx + j];
        if (amax < abs(v)) {
            amax = abs(v);
            vmax = v;
        }
    }

    const float d  = vmax / -8;
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_0/2; ++j) {
        const float x0 = data_s[src_idx + 0              + j]*id;
        const float x1 = data_s[src_idx + QUANT_K_Q4_0/2 + j]*id;

        const uint xi0 = min(15, int(x0 + 8.5));
        const uint xi1 = min(15, int(x1 + 8.5));

        data_q[dst_idx].qs[j]  = uint8_t(xi0 | (xi1 << 4));
    }
}
#endif

#if defined(DATA_A_Q4_1)
void quantize(uint dst_idx, uint src_idx)
{
    float vmin = 1.0/0.0;
    float vmax = -vmin;

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_1; ++j) {
        const float v = data_s[src_idx + j];

        if (v < vmin) vmin = v;
        if (v > vmax) vmax = v;
    }

    const float d  = (vmax - vmin) / ((1 << 4) - 1);
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);
    data_q[dst_idx].m = float16_t(vmin);

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_1/2; ++j) {
        const float x0 = (data_s[src_idx + 0              + j] - vmin)*id;
        const float x1 = (data_s[src_idx + QUANT_K_Q4_1/2 + j] - vmin)*id;

        const uint xi0 = min(15, int(x0 + 0.5));
        const uint xi1 = min(15, int(x1 + 0.5));

        data_q[dst_idx].qs[j]  = uint8_t(xi0 | (xi1 << 4));
    }
}
#endif

#if defined(DATA_A_Q5_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    float vmax = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_Q5_0; ++j) {
        const float v = data_s[src_idx + j];
        if (amax < abs(v)) {
            amax = abs(v);
            vmax = v;
        }
    }

    const float d  = vmax / -16;
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);

    uint32_t qh = 0;
    [[unroll]] for (int j = 0; j < QUANT_K_Q5_0/2; ++j) {
        const float x0 = data_s[src_idx + 0              + j]*id;
        const float x1 = data_s[src_idx + QUANT_K_Q5_0/2 + j]*id;

        const uint xi0 = min(31, int(x0 + 16.5));
        const uint xi1 = min(31, int(x1 + 16.5));

        data_q[dst_idx].qs[j]  = uint8_t((xi0 & 0xf) | ((xi1 & 0xf) << 4));
        qh |= ((xi0 & 0x10u) >> 4) << (j + 0);
        qh |= ((xi1 & 0x10u) >> 4) << (j + QUANT_K_Q5_0/2);
    }
    data_q[dst_idx].qh[0] = uint16_t(qh & 0xFFFF);
    data_q[dst_idx].qh[1] = uint16_t(qh >> 16);
}
#endif

#if defined(DATA_A_Q5_1)
void quantize(uint dst_idx, uint src_idx)
{
    float min = data_s[src_idx + 0];
    float max = min;

    [[unroll]] for (int j = 1; j < QUANT_K_Q5_1; ++j) {
        const float v = data_s[src_idx + j];
        min = v < min ? v : min;
        max = v > max ? v : max;
    }

    const float d  = (max - min) / 31;
    const float id = (d != 0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);
    data_q[dst_idx].m = float16_t(min);

    uint32_t qh = 0;
    [[unroll]] for (int j = 0; j < QUANT_K_Q5_1/2; ++j) {
        const float x0 = (data_s[src_idx + 0              + j] - min)*id;
        const float x1 = (data_s[src_idx + QUANT_K_Q5_1/2 + j] - min)*id;

        const uint xi0 = uint(x0 + 0.5);
        const uint xi1 = uint(x1 + 0.5);

        data_q[dst_idx].qs[j]  = uint8_t((xi0 & 0xf) | ((xi1 & 0xf) << 4));
        qh |= ((xi0 & 0x10u) >> 4) << (j + 0);
        qh |= ((xi1 & 0x10u) >> 4) << (j + QUANT_K_Q5_1/2);
    }
    data_q[dst_idx].qh = qh;
}
#endif

#if defined(DATA_A_Q8_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0; // absolute max

    [[unroll]] for (int j = 0; j < QUANT_K_Q8_0; j++) {
        const float v = data_s[src_idx + j];
        amax = max(amax, abs(v));
    }

    const float d = amax / ((1 << 7) - 1);
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);

    [[unroll]] for (int j = 0; j < QUANT_K_Q8_0; ++j) {
        const float x0 = data_s[src_idx + j]*id;

        data_q[dst_idx].qs[j] = int8_t(round(x0));
    }
}
#endif

#if defined(DATA_A_IQ4_NL)
uint best_index(float x) {
    if (x <= kvalues_iq4nl[0]) return 0;
    if (x >= kvalues_iq4nl[15]) return 15;
    int ml = 0, mu = 15;
    while (mu-ml > 1) {
        int mav = (ml+mu)/2;
        if (x < kvalues_iq4nl[mav]) mu = mav; else ml = mav;
    }
    return x - kvalues_iq4nl[mu-1] < kvalues_iq4nl[mu] - x ? mu-1 : mu;
}

void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    float vmax = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_IQ4_NL; ++j) {
        const float v = data_s[src_idx + j];
        if (amax < abs(v)) {
            amax = abs(v);
            vmax = v;
        }
    }

    float d = vmax / kvalues_iq4nl[0];
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    float sumqx = 0, sumq2 = 0;
    [[unroll]] for (int j = 0; j < QUANT_K_IQ4_NL/2; ++j) {
        const float x0 = data_s[src_idx + 0                + j]*id;
        const float x1 = data_s[src_idx + QUANT_K_IQ4_NL/2 + j]*id;
        const uint xi0 = best_index(x0);
        const uint xi1 = best_index(x1);
        data_q[dst_idx].qs[j] = uint8_t(xi0 | (xi1 << 4));
        const float v0 = kvalues_iq4nl[xi0];
        const float v1 = kvalues_iq4nl[xi1];
        const float w0 = data_s[src_idx + 0                + j]*data_s[src_idx + 0                + j];
        const float w1 = data_s[src_idx + QUANT_K_IQ4_NL/2 + j]*data_s[src_idx + QUANT_K_IQ4_NL/2 + j];
        sumqx += w0*v0*data_s[src_idx + j] + w1*v1*data_s[src_idx + QUANT_K_IQ4_NL/2 + j];
        sumq2 += w0*v0*v0 + w1*v1*v1;
    }

    data_q[dst_idx].d = float16_t(sumq2 > 0 ? sumqx/sumq2 : d);

}
#endif

#if defined(DATA_A_Q4_K)
void quantize(uint dst_idx, uint src_idx)
{
    float mins[8], scales[8];
    float max_scale = 0.0, max_min = 0.0;

    // Pass 1: find per-sub-block scale and min
    for (int j = 0; j < 8; ++j) {
        float vmin = data_s[src_idx + 32*j];
        float vmax = vmin;
        [[unroll]] for (int l = 1; l < 32; ++l) {
            float v = data_s[src_idx + 32*j + l];
            vmin = min(vmin, v);
            vmax = max(vmax, v);
        }
        scales[j] = (vmax - vmin) / 15.0;
        mins[j] = -vmin;
        max_scale = max(max_scale, scales[j]);
        max_min = max(max_min, mins[j]);
    }

    float inv_scale = max_scale > 0 ? 63.0 / max_scale : 0.0;
    float inv_min   = max_min   > 0 ? 63.0 / max_min   : 0.0;

    float dall = max_scale / 63.0;
    float dmin_val = max_min / 63.0;
    data_q[dst_idx].d.x = float16_t(dall);
    data_q[dst_idx].d.y = float16_t(dmin_val);

    // Pack 6-bit scales (ls) and mins (lm) into 12-byte scales array
    uint ls[8], lm[8];
    for (int j = 0; j < 8; ++j) {
        ls[j] = min(63, uint(scales[j] * inv_scale + 0.5));
        lm[j] = min(63, uint(mins[j]   * inv_min   + 0.5));
    }

    for (int j = 0; j < 4; ++j) {
        data_q[dst_idx].scales[j]   = uint8_t(ls[j] | ((ls[j+4] >> 4) << 6));
        data_q[dst_idx].scales[j+4] = uint8_t(lm[j] | ((lm[j+4] >> 4) << 6));
        data_q[dst_idx].scales[j+8] = uint8_t((ls[j+4] & 0xF) | ((lm[j+4] & 0xF) << 4));
    }

    // Re-read dall/dmin from the quantized f16 values for consistency
    dall = float(float16_t(dall));
    dmin_val = float(float16_t(dmin_val));

    for (int j = 0; j < 4; ++j) {
        // Two sub-blocks share the same qs bytes: low nibble = sub-block 2j, high nibble = sub-block 2j+1
        float d0 = dall * float(ls[2*j]);
        float m0 = dmin_val * float(lm[2*j]);
        float d1 = dall * float(ls[2*j+1]);
        float m1 = dmin_val * float(lm[2*j+1]);
        float id0 = (d0 != 0.0) ? 1.0/d0 : 0.0;
        float id1 = (d1 != 0.0) ? 1.0/d1 : 0.0;

        [[unroll]] for (int l = 0; l < 32; ++l) {
            uint q0 = uint(clamp((data_s[src_idx + 64*j + l]      + m0) * id0 + 0.5, 0.0, 15.0));
            uint q1 = uint(clamp((data_s[src_idx + 64*j + l + 32] + m1) * id1 + 0.5, 0.0, 15.0));
            data_q[dst_idx].qs[32*j + l] = uint8_t(q0 | (q1 << 4));
        }
    }
}
#endif

#if defined(DATA_A_Q5_K)
void quantize(uint dst_idx, uint src_idx)
{
    float mins[8], scales[8];
    float max_scale = 0.0, max_min = 0.0;

    for (int j = 0; j < 8; ++j) {
        float vmin = data_s[src_idx + 32*j];
        float vmax = vmin;
        [[unroll]] for (int l = 1; l < 32; ++l) {
            float v = data_s[src_idx + 32*j + l];
            vmin = min(vmin, v);
            vmax = max(vmax, v);
        }
        scales[j] = (vmax - vmin) / 31.0;
        mins[j] = -vmin;
        max_scale = max(max_scale, scales[j]);
        max_min = max(max_min, mins[j]);
    }

    float inv_scale = max_scale > 0 ? 63.0 / max_scale : 0.0;
    float inv_min   = max_min   > 0 ? 63.0 / max_min   : 0.0;

    float dall = max_scale / 63.0;
    float dmin_val = max_min / 63.0;
    data_q[dst_idx].d.x = float16_t(dall);
    data_q[dst_idx].d.y = float16_t(dmin_val);

    uint ls[8], lm[8];
    for (int j = 0; j < 8; ++j) {
        ls[j] = min(63, uint(scales[j] * inv_scale + 0.5));
        lm[j] = min(63, uint(mins[j]   * inv_min   + 0.5));
    }

    for (int j = 0; j < 4; ++j) {
        data_q[dst_idx].scales[j]   = uint8_t(ls[j] | ((ls[j+4] >> 4) << 6));
        data_q[dst_idx].scales[j+4] = uint8_t(lm[j] | ((lm[j+4] >> 4) << 6));
        data_q[dst_idx].scales[j+8] = uint8_t((ls[j+4] & 0xF) | ((lm[j+4] & 0xF) << 4));
    }

    dall = float(float16_t(dall));
    dmin_val = float(float16_t(dmin_val));

    for (int j = 0; j < 4; ++j) {
        float d0 = dall * float(ls[2*j]);
        float m0 = dmin_val * float(lm[2*j]);
        float d1 = dall * float(ls[2*j+1]);
        float m1 = dmin_val * float(lm[2*j+1]);
        float id0 = (d0 != 0.0) ? 1.0/d0 : 0.0;
        float id1 = (d1 != 0.0) ? 1.0/d1 : 0.0;

        [[unroll]] for (int l = 0; l < 32; ++l) {
            uint q0 = uint(clamp((data_s[src_idx + 64*j + l]      + m0) * id0 + 0.5, 0.0, 31.0));
            uint q1 = uint(clamp((data_s[src_idx + 64*j + l + 32] + m1) * id1 + 0.5, 0.0, 31.0));
            data_q[dst_idx].qs[32*j + l] = uint8_t((q0 & 0xF) | ((q1 & 0xF) << 4));
            // High bits: bit for element 64*j+l is bit (2*j) of qh[l],
            //            bit for element 64*j+l+32 is bit (2*j+1) of qh[l]
            if (j == 0) data_q[dst_idx].qh[l] = uint8_t(0);
            data_q[dst_idx].qh[l] |= uint8_t(((q0 >> 4) << (2*j)) | ((q1 >> 4) << (2*j + 1)));
        }
    }
}
#endif

#if defined(DATA_A_Q6_K)
void quantize(uint dst_idx, uint src_idx)
{
    // Q6_K: 16 sub-blocks of 16 elements, each with an int8 scale
    float max_abs_scale = 0.0;

    float sb_scales[16];
    for (int j = 0; j < 16; ++j) {
        float amax = 0.0;
        [[unroll]] for (int l = 0; l < 16; ++l) {
            amax = max(amax, abs(data_s[src_idx + 16*j + l]));
        }
        sb_scales[j] = amax / 32.0;
        max_abs_scale = max(max_abs_scale, sb_scales[j]);
    }

    float d = max_abs_scale / 127.0;
    float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);

    int q_scales[16];
    for (int j = 0; j < 16; ++j) {
        q_scales[j] = int(clamp(sb_scales[j] * id + 0.5, 0.0, 127.0));
        data_q[dst_idx].scales[j] = int8_t(q_scales[j]);
    }

    for (int ip = 0; ip < 2; ++ip) {
        for (int il = 0; il < 32; ++il) {
            uint si0 = (8*ip + il/16);
            uint si1 = (8*ip + il/16 + 2);
            uint si2 = (8*ip + il/16 + 4);
            uint si3 = (8*ip + il/16 + 6);

            float isc0 = (q_scales[si0] != 0) ? 1.0 / (d * float(q_scales[si0])) : 0.0;
            float isc1 = (q_scales[si1] != 0) ? 1.0 / (d * float(q_scales[si1])) : 0.0;
            float isc2 = (q_scales[si2] != 0) ? 1.0 / (d * float(q_scales[si2])) : 0.0;
            float isc3 = (q_scales[si3] != 0) ? 1.0 / (d * float(q_scales[si3])) : 0.0;

            uint q0 = uint(clamp(data_s[src_idx + 128*ip + il]      * isc0 + 32.5, 0.0, 63.0));
            uint q1 = uint(clamp(data_s[src_idx + 128*ip + il + 32] * isc1 + 32.5, 0.0, 63.0));
            uint q2 = uint(clamp(data_s[src_idx + 128*ip + il + 64] * isc2 + 32.5, 0.0, 63.0));
            uint q3 = uint(clamp(data_s[src_idx + 128*ip + il + 96] * isc3 + 32.5, 0.0, 63.0));

            data_q[dst_idx].ql[64*ip + il]      = uint8_t((q0 & 0xF) | ((q2 & 0xF) << 4));
            data_q[dst_idx].ql[64*ip + il + 32]  = uint8_t((q1 & 0xF) | ((q3 & 0xF) << 4));
            data_q[dst_idx].qh[32*ip + il]       = uint8_t(((q0 >> 4) & 3) | (((q1 >> 4) & 3) << 2) | (((q2 >> 4) & 3) << 4) | (((q3 >> 4) & 3) << 6));
        }
    }
}
#endif

#if defined(DATA_A_F32) || defined(DATA_A_F16)
void quantize(uint dst_idx, uint src_idx)
{
    data_q[dst_idx] = A_TYPE(data_s[src_idx]);
}
#endif

#if defined(DATA_A_BF16)
void quantize(uint dst_idx, uint src_idx)
{
    data_q[dst_idx] = A_TYPE(fp32_to_bf16(data_s[src_idx]));
}
#endif

#if defined(SET_ROWS)

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    const uint idx = ((gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x) * BLOCK_SIZE + gl_LocalInvocationID.x) * QUANT_K;

    if (idx >= p.ne) {
        return;
    }

    uint i00, i01, i02, i03;
    get_indices(idx, i00, i01, i02, i03);

    uint i12 = fastmod(i03, p.ne12);
    uint i11 = fastmod(i02, p.ne11);
    uint i10 = i01;

    uint i1 = data_i[src1_idx(i10, i11, i12, 0) + get_boffset()].x;

    uint src0_idx = src0_idx(i00, i01, i02, i03) + get_aoffset();
    uint dst_idx = dst_idx(i00 / QUANT_K, i1, i02, i03) + get_doffset();

    quantize(dst_idx, src0_idx);
}

#else

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    const uint idx = (gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x) * QUANT_K;

    if (idx >= p.ne) {
        return;
    }

    uint dst_idx = dst_idx_quant(idx, QUANT_K);
    uint src_idx = get_aoffset() + src0_idx(idx);

    quantize(dst_idx, src_idx);
}

#endif
