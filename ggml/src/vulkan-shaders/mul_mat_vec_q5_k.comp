#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void calc_superblock(const uint a_offset, const uint b_offset, const uint v_im, const uint l0, const uint q_offset, const uint y_offset, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    const uint y1_idx = i * QUANT_K + y_offset;
    const uint y2_idx = y1_idx + 128;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint ib0 = a_offset + (first_row+n)*num_blocks_per_row;
        vec2 d = vec2(data_a[ib0 + i].d);
        const FLOAT_TYPE dall = FLOAT_TYPE(d.x);
        const FLOAT_TYPE dmin = FLOAT_TYPE(d.y);

        const uint32_t scale0_u32 = data_a_packed16[ib0 + i].scales[v_im    ];
        const uint32_t scale4_u32 = data_a_packed16[ib0 + i].scales[v_im + 2];
        const uint32_t scale8_u32 = data_a_packed16[ib0 + i].scales[v_im + 4];

        const uint32_t scale_0_4_l = (scale4_u32 << 16) | scale0_u32;
        const uint32_t scale_0_4_h = (scale_0_4_l & 0xC0C0C0C0) >> 2;
        const vec4 scale_0_4_l_f = vec4(unpack8(scale_0_4_l & 0x3F3F3F3F));
        const vec4 scale8_f = vec4(unpack8((((scale8_u32 << 12) | scale8_u32) & 0x0F0F0F0F) | scale_0_4_h));

        const FLOAT_TYPE sc0 = FLOAT_TYPE(scale_0_4_l_f.x);
        const FLOAT_TYPE sc1 = FLOAT_TYPE(scale_0_4_l_f.y);
        const FLOAT_TYPE sc2 = FLOAT_TYPE(scale_0_4_l_f.z);
        const FLOAT_TYPE sc3 = FLOAT_TYPE(scale_0_4_l_f.w);
        const FLOAT_TYPE sc4 = FLOAT_TYPE(scale8_f.x);
        const FLOAT_TYPE sc5 = FLOAT_TYPE(scale8_f.y);
        const FLOAT_TYPE sc6 = FLOAT_TYPE(scale8_f.z);
        const FLOAT_TYPE sc7 = FLOAT_TYPE(scale8_f.w);

        const uint32_t qs0_16_u32 = uint32_t(data_a_packed16[ib0 + i].qs[q_offset / 2]) | (uint32_t(data_a_packed16[ib0 + i].qs[q_offset / 2 + 8]) << 16);
        const uint32_t qs64_80_u32 = uint32_t(data_a_packed16[ib0 + i].qs[q_offset / 2 + 32]) | (uint32_t(data_a_packed16[ib0 + i].qs[q_offset / 2 + 40]) << 16);

        uint32_t qs0_16_u32_lo4 = qs0_16_u32 & 0x0F0F0F0F;
        uint32_t qs0_16_u32_hi4 = (qs0_16_u32 >> 4) & 0x0F0F0F0F;
        uint32_t qs64_80_u32_lo4 = qs64_80_u32 & 0x0F0F0F0F;
        uint32_t qs64_80_u32_hi4 = (qs64_80_u32 >> 4) & 0x0F0F0F0F;

        const uint32_t qh = pack32(u16vec2(data_a_packed16[ib0 + i].qh[l0 / 2], data_a_packed16[ib0 + i].qh[l0 / 2 + 8]));

        const uint32_t qs0_16_lo4_offset16 = ((qh >> (2*v_im)) & 0x01010101) << 4;
        const uint32_t qs0_16_hi4_offset16 = ((qh >> (2*v_im)) & 0x02020202) << 3;
        const uint32_t qs64_80_lo4_offset16 = ((qh >> (2*v_im)) & 0x10101010);
        const uint32_t qs64_80_hi4_offset16 = ((qh >> (2*v_im)) & 0x20202020) >> 1;

        qs0_16_u32_lo4 += qs0_16_lo4_offset16;
        qs0_16_u32_hi4 += qs0_16_hi4_offset16;
        qs64_80_u32_lo4 += qs64_80_lo4_offset16;
        qs64_80_u32_hi4 += qs64_80_hi4_offset16;

        const vec4 qs0_16_lo4 = vec4(unpack8(qs0_16_u32_lo4));
        const vec4 qs64_80_lo4 = vec4(unpack8(qs64_80_u32_lo4));
        const vec4 qs0_16_hi4 = vec4(unpack8(qs0_16_u32_hi4));
        const vec4 qs64_80_hi4 = vec4(unpack8(qs64_80_u32_hi4));

        const FLOAT_TYPE q4_0  = FLOAT_TYPE(qs0_16_lo4.x);
        const FLOAT_TYPE q4_1  = FLOAT_TYPE(qs0_16_lo4.y);
        const FLOAT_TYPE q4_2  = FLOAT_TYPE(qs0_16_lo4.z);
        const FLOAT_TYPE q4_3  = FLOAT_TYPE(qs0_16_lo4.w);
        const FLOAT_TYPE q4_4  = FLOAT_TYPE(qs0_16_hi4.x);
        const FLOAT_TYPE q4_5  = FLOAT_TYPE(qs0_16_hi4.y);
        const FLOAT_TYPE q4_6  = FLOAT_TYPE(qs0_16_hi4.z);
        const FLOAT_TYPE q4_7  = FLOAT_TYPE(qs0_16_hi4.w);
        const FLOAT_TYPE q4_8  = FLOAT_TYPE(qs64_80_lo4.x);
        const FLOAT_TYPE q4_9  = FLOAT_TYPE(qs64_80_lo4.y);
        const FLOAT_TYPE q4_10 = FLOAT_TYPE(qs64_80_lo4.z);
        const FLOAT_TYPE q4_11 = FLOAT_TYPE(qs64_80_lo4.w);
        const FLOAT_TYPE q4_12 = FLOAT_TYPE(qs64_80_hi4.x);
        const FLOAT_TYPE q4_13 = FLOAT_TYPE(qs64_80_hi4.y);
        const FLOAT_TYPE q4_14 = FLOAT_TYPE(qs64_80_hi4.z);
        const FLOAT_TYPE q4_15 = FLOAT_TYPE(qs64_80_hi4.w);

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            vec2 by10 =  vec2(data_b_v2[(j*p.batch_stride_b + b_offset + y1_idx) / 2     ]);
            vec2 by116 = vec2(data_b_v2[(j*p.batch_stride_b + b_offset + y1_idx) / 2 +  8]);
            vec2 by132 = vec2(data_b_v2[(j*p.batch_stride_b + b_offset + y1_idx) / 2 + 16]);
            vec2 by148 = vec2(data_b_v2[(j*p.batch_stride_b + b_offset + y1_idx) / 2 + 24]);
            vec2 by20 =  vec2(data_b_v2[(j*p.batch_stride_b + b_offset + y2_idx) / 2     ]);
            vec2 by216 = vec2(data_b_v2[(j*p.batch_stride_b + b_offset + y2_idx) / 2 +  8]);
            vec2 by232 = vec2(data_b_v2[(j*p.batch_stride_b + b_offset + y2_idx) / 2 + 16]);
            vec2 by248 = vec2(data_b_v2[(j*p.batch_stride_b + b_offset + y2_idx) / 2 + 24]);

#if defined(USE_F16ACC)
            // RPM path: each 4-wide dot becomes two paired f16vec2 fma's.
            // Inputs arrive as vec2 pairs already, so build f16vec2 by pairing
            // adjacent by*[lo|hi].x/.y halves with consecutive q4_* scalars.
            const f16vec2 by10_h  = f16vec2(by10);
            const f16vec2 by116_h = f16vec2(by116);
            const f16vec2 by132_h = f16vec2(by132);
            const f16vec2 by148_h = f16vec2(by148);
            const f16vec2 by20_h  = f16vec2(by20);
            const f16vec2 by216_h = f16vec2(by216);
            const f16vec2 by232_h = f16vec2(by232);
            const f16vec2 by248_h = f16vec2(by248);

            f16vec2 sx_acc = by10_h  * f16vec2(q4_0, q4_1);
            sx_acc = fma(by116_h, f16vec2(q4_2, q4_3), sx_acc);
            const FLOAT_TYPE sx = sx_acc.x + sx_acc.y;

            f16vec2 sy_acc = by132_h * f16vec2(q4_4, q4_5);
            sy_acc = fma(by148_h, f16vec2(q4_6, q4_7), sy_acc);
            const FLOAT_TYPE sy = sy_acc.x + sy_acc.y;

            f16vec2 sz_acc = by20_h  * f16vec2(q4_8, q4_9);
            sz_acc = fma(by216_h, f16vec2(q4_10, q4_11), sz_acc);
            const FLOAT_TYPE sz = sz_acc.x + sz_acc.y;

            f16vec2 sw_acc = by232_h * f16vec2(q4_12, q4_13);
            sw_acc = fma(by248_h, f16vec2(q4_14, q4_15), sw_acc);
            const FLOAT_TYPE sw = sw_acc.x + sw_acc.y;

            // smin = sc2*(sum by10+by116) + sc3*(sum by132+by148) + sc6*(sum by20+by216) + sc7*(sum by232+by248)
            const f16vec2 bymin10 = by10_h  + by116_h;
            const f16vec2 bymin32 = by132_h + by148_h;
            const f16vec2 bymin20 = by20_h  + by216_h;
            const f16vec2 bymin32b = by232_h + by248_h;
            const f16vec2 sum1032 = f16vec2(bymin10.x + bymin10.y, bymin32.x + bymin32.y);
            const f16vec2 sum2032 = f16vec2(bymin20.x + bymin20.y, bymin32b.x + bymin32b.y);
            f16vec2 smin_acc = sum1032 * f16vec2(sc2, sc3);
            smin_acc = fma(sum2032, f16vec2(sc6, sc7), smin_acc);
            const FLOAT_TYPE smin = smin_acc.x + smin_acc.y;

            // Scale multiply in f32 — dot products (sx..sw) can reach O(1000+)
            // with large activations; scales are 6-bit (0..63). The product
            // overflows f16 max (65504). Inner f16vec2 fma's still emit RPM.
            const float d_sum = float(sx) * float(sc0) + float(sy) * float(sc1)
                              + float(sz) * float(sc4) + float(sw) * float(sc5);
            temp[j][n] = fma(dall, FLOAT_TYPE(d_sum), fma(-dmin, smin, temp[j][n]));
#else
            const FLOAT_TYPE sx =
              fma(FLOAT_TYPE(by10.x), q4_0,
              fma(FLOAT_TYPE(by10.y), q4_1,
              fma(FLOAT_TYPE(by116.x), q4_2,
                 FLOAT_TYPE(by116.y) * q4_3)));
            const FLOAT_TYPE sy =
              fma(FLOAT_TYPE(by132.x), q4_4,
              fma(FLOAT_TYPE(by132.y), q4_5,
              fma(FLOAT_TYPE(by148.x), q4_6,
                 FLOAT_TYPE(by148.y) * q4_7)));
            const FLOAT_TYPE sz =
              fma(FLOAT_TYPE(by20.x), q4_8,
              fma(FLOAT_TYPE(by20.y), q4_9,
              fma(FLOAT_TYPE(by216.x), q4_10,
                 FLOAT_TYPE(by216.y) * q4_11)));
            const FLOAT_TYPE sw =
              fma(FLOAT_TYPE(by232.x), q4_12,
              fma(FLOAT_TYPE(by232.y), q4_13,
              fma(FLOAT_TYPE(by248.x), q4_14,
                 FLOAT_TYPE(by248.y) * q4_15)));
            const FLOAT_TYPE smin =
              fma(FLOAT_TYPE(by10.x) + FLOAT_TYPE(by10.y) + FLOAT_TYPE(by116.x) + FLOAT_TYPE(by116.y), sc2,
              fma(FLOAT_TYPE(by132.x) + FLOAT_TYPE(by132.y) + FLOAT_TYPE(by148.x) + FLOAT_TYPE(by148.y), sc3,
              fma(FLOAT_TYPE(by20.x) + FLOAT_TYPE(by20.y) + FLOAT_TYPE(by216.x) + FLOAT_TYPE(by216.y), sc6,
                  (FLOAT_TYPE(by232.x) + FLOAT_TYPE(by232.y) + FLOAT_TYPE(by248.x) + FLOAT_TYPE(by248.y)) * sc7)));
            temp[j][n] = fma(dall, fma(sx, sc0, fma(sy, sc1, fma(sz, sc4, sw * sc5))), fma(-dmin, smin, temp[j][n]));
#endif
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    // 16 threads are used to process each block
    const uint it_size = gl_WorkGroupSize.x/16;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid%16;  // 0...15
    const uint ix = tid/16;

    const uint il = itid/4;                          // 0...3
    const uint ir = itid - 4*il;                     // 0...3

    const uint v_im = il / 2;  // 0 or 1. 0 computes 0,32 + 128,160, 1 computes 64,96 + 192,224
    const uint v_in = il % 2;

    const uint l0 = 4*ir + 2*v_in;                   // 0...15
    const uint q_offset = 32*v_im + l0;
    const uint y_offset = 64*v_im + l0;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += it_size)
        calc_superblock(a_offset, b_offset, v_im, l0, q_offset, y_offset, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
