            buf_a_gate[buf_idx + 3] = FLOAT_TYPE((sign &   8) != 0 ? -v.w : v.w);
            }
#elif defined(DATA_A_IQ3_S)
            {
            const uint idx = pos_a_gate + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + loadr_a * LOAD_VEC_A;
            const uint ib = idx / 64;
            const uint iqs = idx % 64;
            const uint iqh = iqs / 8;
            const float d = float(data_a_gate[ib].d);
            const uint qs = data_a_gate[ib].qs[iqs];
            const uint qh = data_a_gate[ib].qh[iqh];
            const int8_t sign = int8_t(data_a_gate[ib].signs[iqs / 2] >> (4 * (idx % 2)));
            const uint scale = data_a_gate[ib].scales[iqs / 16];
            const i8vec2 sign01 = i8vec2(1 - (2 & i8vec2(sign << 1, sign)));
            const float db = d * (1 + 2 * ((scale >> (4 * (iqh & 1))) & 0xf));
            const uint32_t grid = iq3s_grid[qs | ((qh << (8 - (iqs % 8))) & 256)];
            const vec4 v = db * vec4(unpack8(grid));
            buf_a_gate[buf_idx    ] = FLOAT_TYPE((sign &   1) != 0 ? -v.x : v.x);
            buf_a_gate[buf_idx + 1] = FLOAT_TYPE((sign &   2) != 0 ? -v.y : v.y);
            buf_a_gate[buf_idx + 2] = FLOAT_TYPE((sign &   4) != 0 ? -v.z : v.z);
            buf_a_gate[buf_idx + 3] = FLOAT_TYPE((sign &   8) != 0 ? -v.w : v.w);
            }
#elif defined(DATA_A_IQ4_XS)
            {
            const uint idx = pos_a_gate + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + loadr_a * LOAD_VEC_A;
            const uint ib = idx / 128;
            const uint ib32 = (idx % 128) / 16;
            const uint iq = 16 * ib32 + 2 * (idx % 8);
            const uint sl = (data_a_gate[ib].scales_l[ib32/2] >> (4 * (ib32 & 1))) & 0xF;
            const uint sh = ((data_a_gate[ib].scales_h) >> (2 * ib32)) & 3;
            const uint qshift = (idx & 8) >> 1;
            u8vec2 qs = u8vec2(data_a_gate[ib].qs[iq], data_a_gate[ib].qs[iq + 1]);
            qs = (qs >> qshift) & uint8_t(0xF);
            const float d = float(data_a_gate[ib].d);
            const vec2 v = d * float(int(sl | (sh << 4)) - 32) * vec2(kvalues_iq4nl[qs.x], kvalues_iq4nl[qs.y]);
            buf_a_gate[buf_idx    ] = FLOAT_TYPE(v.x);
            buf_a_gate[buf_idx + 1] = FLOAT_TYPE(v.y);
            }
#elif defined(DATA_A_IQ4_NL)
            {
            const uint idx = pos_a_gate + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + 2 * loadr_a;
            const uint ib = idx / 8;
            const uint iqs = idx & 0x07;
            const FLOAT_TYPE d = FLOAT_TYPE(data_a_gate_packed16[ib].d);
            const uint vui = uint(data_a_gate_packed16[ib].qs[iqs]);
            buf_a_gate[buf_idx     ] = FLOAT_TYPE(kvalues_iq4nl[vui & 0xF]) * d;
            buf_a_gate[buf_idx + 1 ] = FLOAT_TYPE(kvalues_iq4nl[bitfieldExtract(vui, 8, 4)]) * d;
            buf_a_gate[buf_idx + 16] = FLOAT_TYPE(kvalues_iq4nl[bitfieldExtract(vui, 4, 4)]) * d;
            buf_a_gate[buf_idx + 17] = FLOAT_TYPE(kvalues_iq4nl[vui >> 12]) * d;
            }
#endif
        }

        // ========== Load B tile into buf_b ==========
        [[unroll]] for (uint l = 0; l < BN; l += loadstride_b) {
#if LOAD_VEC_B == 8
#ifdef MUL_MAT_ID
            {
            const u16vec2 row_idx = row_ids[ic * BN + loadc_b + l];
            const uint idx = pos_b + row_idx.y * p.batch_stride_b / LOAD_VEC_B + (row_idx.x % p_ne11) * p.stride_b / LOAD_VEC_B + loadr_b;
#else
            {
            const uint idx = pos_b + (loadc_b + l) * p.stride_b / LOAD_VEC_B + loadr_b;
#endif
            const uint buf_idx = (loadc_b + l) * SHMEM_STRIDE + loadr_b * LOAD_VEC_B;
            buf_b[buf_idx + 0] = FLOAT_TYPE(data_b[idx][0].x);
            buf_b[buf_idx + 1] = FLOAT_TYPE(data_b[idx][0].y);
            buf_b[buf_idx + 2] = FLOAT_TYPE(data_b[idx][0].z);
            buf_b[buf_idx + 3] = FLOAT_TYPE(data_b[idx][0].w);
            buf_b[buf_idx + 4] = FLOAT_TYPE(data_b[idx][1].x);
            buf_b[buf_idx + 5] = FLOAT_TYPE(data_b[idx][1].y);
            buf_b[buf_idx + 6] = FLOAT_TYPE(data_b[idx][1].z);
            buf_b[buf_idx + 7] = FLOAT_TYPE(data_b[idx][1].w);
            }
#elif LOAD_VEC_B == 4
#ifdef MUL_MAT_ID
            {
            const u16vec2 row_idx = row_ids[ic * BN + loadc_b + l];
            const uint idx = pos_b + row_idx.y * p.batch_stride_b / LOAD_VEC_B + (row_idx.x % p_ne11) * p.stride_b / LOAD_VEC_B + loadr_b;
#else
            {
            const uint idx = pos_b + (loadc_b + l) * p.stride_b / LOAD_VEC_B + loadr_b;
#endif
            const uint buf_idx = (loadc_b + l) * SHMEM_STRIDE + loadr_b * LOAD_VEC_B;
            buf_b[buf_idx + 0] = TO_FLOAT_TYPE(data_b[idx].x);
            buf_b[buf_idx + 1] = TO_FLOAT_TYPE(data_b[idx].y);
            buf_b[buf_idx + 2] = TO_FLOAT_TYPE(data_b[idx].z);
            buf_b[buf_idx + 3] = TO_FLOAT_TYPE(data_b[idx].w);
            }
#else
#ifdef MUL_MAT_ID
            const uint row_i = ic * BN + loadc_b + l;
            if (row_i < _ne1) {
                const u16vec2 row_idx = row_ids[row_i];
                buf_b[(loadc_b + l) * SHMEM_STRIDE + loadr_b] = TO_FLOAT_TYPE(data_b[pos_b + row_idx.y * p.batch_stride_b + (row_idx.x % p_ne11) * p.stride_b + loadr_b]);
            } else {
                buf_b[(loadc_b + l) * SHMEM_STRIDE + loadr_b] = FLOAT_TYPE(0.0f);
            }
#else
            if (ic * BN + loadc_b + l < p.N && block + loadr_b < end_k) {
                buf_b[(loadc_b + l) * SHMEM_STRIDE + loadr_b] = TO_FLOAT_TYPE(data_b[pos_b + (loadc_b + l) * p.stride_b + loadr_b]);
            } else {
                buf_b[(loadc_b + l) * SHMEM_STRIDE + loadr_b] = FLOAT_TYPE(0.0f);
            }
#endif
#endif
        }

        barrier();

        pos_a_up += BK / LOAD_VEC_A;
        pos_a_gate += BK / LOAD_VEC_A;
        pos_b += BK / LOAD_VEC_B;

        // ========== Accumulate both matmuls ==========
        [[unroll]] for (uint i = 0; i < BK; i++) {
            // Load UP tile from shared into cache and accumulate
            [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                [[unroll]] for (uint j = 0; j < TM; j++) {
                    cache_a[wsir * TM + j] = buf_a_up[(warp_r * WM + wsir * WSUBM + tiwr * TM + j) * SHMEM_STRIDE + i];
                }
            }
            [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
                [[unroll]] for (uint j = 0; j < TN; j++) {
                    cache_b[j] = buf_b[(warp_c * WN + wsic * WSUBN + tiwc * TN + j) * SHMEM_STRIDE + i];
                }
                [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                    [[unroll]] for (uint cc = 0; cc < TN; cc++) {
                        [[unroll]] for (uint cr = 0; cr < TM; cr++) {
                            const uint sums_idx = (wsic * TN + cc) * (WMITER * TM) + wsir * TM + cr;
                            sums_up[sums_idx] = fma(ACC_TYPE(cache_a[wsir * TM + cr]), ACC_TYPE(cache_b[cc]), sums_up[sums_idx]);
                        }
                    }
                }
            }

            // Load GATE tile from shared into cache and accumulate
            [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                [[unroll]] for (uint j = 0; j < TM; j++) {
                    cache_a[wsir * TM + j] = buf_a_gate[(warp_r * WM + wsir * WSUBM + tiwr * TM + j) * SHMEM_STRIDE + i];
                }
            }
            [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
                [[unroll]] for (uint j = 0; j < TN; j++) {
                    cache_b[j] = buf_b[(warp_c * WN + wsic * WSUBN + tiwc * TN + j) * SHMEM_STRIDE + i];
                }
                [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                    [[unroll]] for (uint cc = 0; cc < TN; cc++) {
                        [[unroll]] for (uint cr = 0; cr < TM; cr++) {
                            const uint sums_idx = (wsic * TN + cc) * (WMITER * TM) + wsir * TM + cr;
                            sums_gate[sums_idx] = fma(ACC_TYPE(cache_a[wsir * TM + cr]), ACC_TYPE(cache_b[cc]), sums_gate[sums_idx]);
                        }
                    }
                }
            }
        }

        barrier();
    }

    // ========== Write out: output = sums_up * activation(sums_gate) ==========
    const uint dr = ir * BM + warp_r * WM;
    const uint dc = ic * BN + warp_c * WN;

#ifndef MUL_MAT_ID
    const uint offsets = batch_idx * p.batch_stride_d;
#endif

    [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
        [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {

            const uint dr_warp = dr + wsir * WSUBM + tiwr * TM;
            const uint dc_warp = dc + wsic * WSUBN + tiwc * TN;
            [[unroll]] for (uint cc = 0; cc < TN; cc++) {
#ifdef MUL_MAT_ID
                const uint row_i = dc_warp + cc;
                if (row_i >= _ne1) break;
                const u16vec2 row_idx = row_ids[row_i];
#endif
                [[unroll]] for (uint cr = 0; cr < TM; cr++) {
#ifdef MUL_MAT_ID
                    if (dr_warp + cr < p.M) {
                        const uint sums_idx = (wsic * TN + cc) * (WMITER * TM) + wsir * TM + cr;
                        const float up_val = float(sums_up[sums_idx]);
                        const float gate_val = float(sums_gate[sums_idx]);
                        data_d[row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + dr_warp + cr] = D_TYPE(up_val * apply_activation(gate_val));
                    }
#else
                    if (dr_warp + cr < p.M && dc_warp + cc < p.N) {
                        const uint sums_idx = (wsic * TN + cc) * (WMITER * TM) + wsir * TM + cr;
                        const float up_val = float(sums_up[sums_idx]);
                        const float gate_val = float(sums_gate[sums_idx]);
                        data_d[offsets + (dc_warp + cc) * p.stride_d + dr_warp + cr] = D_TYPE(up_val * apply_activation(gate_val));
                    }
#endif
                }
            }
        }
    }
}
