#version 450

// Fused dual-matmul shader for GGML_OP_FUSED_UP_GATE and GGML_OP_MOE_FUSED_UP_GATE
// output = mul_mat(up, b) * activation(mul_mat(gate, b))
//
// Forked from mul_mm.comp with:
// - Doubled shared memory A tile (buf_a_up + buf_a_gate)
// - Second weight buffer on binding 3 (gate)
// - Doubled accumulators (sums_up + sums_gate)
// - Inline activation+gating at write-out
// - No COOPMAT or K-split support
//
// MUL_MAT_ID build flag enables the MoE variant: an IDS binding at slot 4,
// expert-indexed weight loads, and row_ids indirection for B loading and
// output writing — mirroring mul_mm.comp's MUL_MAT_ID branches.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require

#ifdef FLOAT16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif
#if defined(DATA_A_IQ1_M)
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif

#include "types.comp"

#ifndef LOAD_VEC_A
#define LOAD_VEC_A 1
#endif
#ifndef LOAD_VEC_B
#define LOAD_VEC_B 1
#endif

#if !defined(TO_FLOAT_TYPE)
#define TO_FLOAT_TYPE FLOAT_TYPE
#endif

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// Binding 0: up weight matrix
layout (binding = 0) readonly buffer A_UP {A_TYPE data_a[];};
#if defined(A_TYPE_PACKED16)
layout (binding = 0) readonly buffer A_UP_PACKED16 {A_TYPE_PACKED16 data_a_packed16[];};
#endif
#if defined(A_TYPE_PACKED32)
layout (binding = 0) readonly buffer A_UP_PACKED32 {A_TYPE_PACKED32 data_a_packed32[];};
#endif

// Binding 1: input b (F32)
layout (binding = 1) readonly buffer B {B_TYPE data_b[];};

// Binding 2: output
layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};

// Binding 3: gate weight matrix (same type as up)
layout (binding = 3) readonly buffer A_GATE {A_TYPE data_a_gate[];};
#if defined(A_TYPE_PACKED16)
layout (binding = 3) readonly buffer A_GATE_PACKED16 {A_TYPE_PACKED16 data_a_gate_packed16[];};
#endif
#if defined(A_TYPE_PACKED32)
layout (binding = 3) readonly buffer A_GATE_PACKED32 {A_TYPE_PACKED32 data_a_gate_packed32[];};
#endif

#ifdef MUL_MAT_ID
// Binding 4: expert IDs (i32)
layout (binding = 4) readonly buffer IDS {int data_ids[];};
#endif

// Push constants. Layout is shared between dense FUSED_UP_GATE and MoE
// MOE_FUSED_UP_GATE so a single C struct (vk_fused_up_gate_push_constants)
// works for both call sites. The MoE variant reinterprets a few of the dense
// "ne0X / broadcast / k_split" slots as nei0/nei1/nbi1/ne11 via the macro
// aliases below. The bytes are the same; only the field names change.
layout (push_constant) uniform parameter
{
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;

    uint batch_stride_a;
    uint batch_stride_b;
    uint batch_stride_d;

    uint k_split;     // unused, always 1 for dense; aliased to nei0 for MoE
    uint ne02;        // dense: src0 batch dim 2; aliased to nei1 for MoE
    uint ne12;        // dense: src1 batch dim 2; aliased to nbi1 for MoE
    uint broadcast2;  // dense: bcast dim 2; aliased to ne11 for MoE
    uint broadcast3;  // dense: bcast dim 3; unused for MoE (padding)
    uint padded_N;

    uint unary_op;    // 0=SILU, 1=GELU, 2=RELU/SWIGLU_OAI
    float limit;      // activation clamp, 0.0 = disabled

    uint batch_stride_a_gate;  // gate may have different batch stride
} p;

#ifdef MUL_MAT_ID
// Macro aliases — let the MoE branches read with their semantic names
// without ifdef'ing every reference site.
#define p_nei0 p.k_split
#define p_nei1 p.ne02
#define p_nbi1 p.ne12
#define p_ne11 p.broadcast2
#endif

layout (constant_id = 0) const uint BLOCK_SIZE = 64;
layout (constant_id = 1) const uint BM = 64;
layout (constant_id = 2) const uint BN = 64;
layout (constant_id = 3) const uint BK = 16;
layout (constant_id = 4) const uint WM = 32;
layout (constant_id = 5) const uint WN = 32;
layout (constant_id = 6) const uint WMITER = 2;
layout (constant_id = 7) const uint TM = 4;
layout (constant_id = 8) const uint TN = 2;
layout (constant_id = 9) const uint TK = 1;
layout (constant_id = 10) const uint WARP = 32;

#define SHMEM_STRIDE (BK + 1)

shared FLOAT_TYPE buf_a_up[BM * SHMEM_STRIDE];
shared FLOAT_TYPE buf_a_gate[BM * SHMEM_STRIDE];
shared FLOAT_TYPE buf_b[BN * SHMEM_STRIDE];

#ifdef MUL_MAT_ID
shared u16vec2 row_ids[4096];
uint _ne1;
#endif

#define NUM_WARPS (BLOCK_SIZE / WARP)

// Activation functions
float silu(float x) {
    return x / (1.0f + exp(-x));
}

float gelu(float x) {
    // GELU approximation matching ggml
    return 0.5f * x * (1.0f + tanh(0.7978845608028654f * x * (1.0f + 0.044715f * x * x)));
}

float apply_activation(float x) {
    if (p.limit > 0.0f) {
        x = clamp(x, -p.limit, p.limit);
    }
    if (p.unary_op == 0u) {
        return silu(x);
    } else if (p.unary_op == 1u) {
        return gelu(x);
    } else {
        return max(x, 0.0f);  // RELU
    }
}

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

#ifdef MUL_MAT_ID
    const uint expert_idx = gl_GlobalInvocationID.z;
#else
    const uint batch_idx = gl_GlobalInvocationID.z;

    const uint i13 = batch_idx / p.ne12;
    const uint i12 = batch_idx % p.ne12;

    const uint i03 = i13 / p.broadcast3;
    const uint i02 = i12 / p.broadcast2;

    const uint batch_idx_a = i03 * p.ne02 + i02;
#endif

    const uint blocks_m = (p.M + BM - 1) / BM;
    const uint ir = gl_WorkGroupID.x % blocks_m;
    const uint ik = gl_WorkGroupID.x / blocks_m;
    const uint ic = gl_WorkGroupID.y;

    const uint WNITER = (WM * WN) / (WARP * TM * TN * WMITER);
    const uint WSUBM = WM / WMITER;
    const uint WSUBN = WN / WNITER;

    const uint warp_i = gl_LocalInvocationID.x / WARP;
    const uint tiw = gl_LocalInvocationID.x % WARP;
    const uint tiwr = tiw % (WSUBM / TM);
    const uint tiwc = tiw / (WSUBM / TM);

    const uint warp_r = warp_i % (BM / WM);
    const uint warp_c = warp_i / (BM / WM);

    const uint loadr_a = gl_LocalInvocationID.x % (BK / LOAD_VEC_A);
    const uint loadc_a = gl_LocalInvocationID.x / (BK / LOAD_VEC_A);
    const uint loadr_b = gl_LocalInvocationID.x % (BK / LOAD_VEC_B);
    const uint loadc_b = gl_LocalInvocationID.x / (BK / LOAD_VEC_B);

    const uint loadstride_a = gl_WorkGroupSize.x * LOAD_VEC_A / BK;
    const uint loadstride_b = gl_WorkGroupSize.x * LOAD_VEC_B / BK;

#ifdef MUL_MAT_ID
    // Build the row_ids[] indirection: scan all (token, expert_slot) entries in
    // the IDS tensor and collect the ones that route to *this* expert. The list
    // length _ne1 is the number of (token, slot) pairs handled by this workgroup.
    _ne1 = 0;
    for (uint ii1 = 0; ii1 < p_nei1; ii1++) {
        for (uint ii0 = 0; ii0 < p_nei0; ii0++) {
            if (data_ids[ii1*p_nbi1 + ii0] == expert_idx) {
                row_ids[_ne1] = u16vec2(ii0, ii1);
                _ne1++;
            }
        }
    }

    barrier();

    // Workgroup has no work for this expert
    if (ic * BN >= _ne1) return;
#endif

    const uint start_k = 0;
    const uint end_k = p.K;

#ifdef MUL_MAT_ID
    uint pos_a_up   = (expert_idx * p.batch_stride_a      + ir * BM * p.stride_a + start_k) / LOAD_VEC_A;
    uint pos_a_gate = (expert_idx * p.batch_stride_a_gate + ir * BM * p.stride_a + start_k) / LOAD_VEC_A;
    uint pos_b = 0;
#else
    uint pos_a_up   = (batch_idx_a * p.batch_stride_a      + ir * BM * p.stride_a + start_k) / LOAD_VEC_A;
    uint pos_a_gate = (batch_idx_a * p.batch_stride_a_gate + ir * BM * p.stride_a + start_k) / LOAD_VEC_A;
    uint pos_b = (batch_idx * p.batch_stride_b + ic * BN * p.stride_b + start_k) / LOAD_VEC_B;
#endif

    // Double accumulators
    ACC_TYPE sums_up[WMITER * TM * WNITER * TN];
    ACC_TYPE sums_gate[WMITER * TM * WNITER * TN];
    FLOAT_TYPE cache_a[WMITER * TM];
    FLOAT_TYPE cache_b[TN];

    [[unroll]] for (uint i = 0; i < WMITER*TM*WNITER*TN; i++) {
        sums_up[i] = ACC_TYPE(0.0f);
        sums_gate[i] = ACC_TYPE(0.0f);
    }

    for (uint block = start_k; block < end_k; block += BK) {
        // ========== Load UP tile into buf_a_up ==========
        [[unroll]] for (uint l = 0; l < BM; l += loadstride_a) {

#if defined(DATA_A_F32) || defined(DATA_A_F16)
#if LOAD_VEC_A == 8
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + loadr_a * LOAD_VEC_A;
            buf_a_up[buf_idx    ] = FLOAT_TYPE(data_a[idx][0].x);
            buf_a_up[buf_idx + 1] = FLOAT_TYPE(data_a[idx][0].y);
            buf_a_up[buf_idx + 2] = FLOAT_TYPE(data_a[idx][0].z);
            buf_a_up[buf_idx + 3] = FLOAT_TYPE(data_a[idx][0].w);
            buf_a_up[buf_idx + 4] = FLOAT_TYPE(data_a[idx][1].x);
            buf_a_up[buf_idx + 5] = FLOAT_TYPE(data_a[idx][1].y);
            buf_a_up[buf_idx + 6] = FLOAT_TYPE(data_a[idx][1].z);
            buf_a_up[buf_idx + 7] = FLOAT_TYPE(data_a[idx][1].w);
            }
#elif LOAD_VEC_A == 4
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + loadr_a * LOAD_VEC_A;
            buf_a_up[buf_idx    ] = FLOAT_TYPE(data_a[idx].x);
            buf_a_up[buf_idx + 1] = FLOAT_TYPE(data_a[idx].y);
            buf_a_up[buf_idx + 2] = FLOAT_TYPE(data_a[idx].z);
            buf_a_up[buf_idx + 3] = FLOAT_TYPE(data_a[idx].w);
            }
#else
            if (ir * BM + loadc_a + l < p.M && block + loadr_a < end_k) {
                buf_a_up[(loadc_a + l) * SHMEM_STRIDE + loadr_a] = FLOAT_TYPE(data_a[pos_a_up + (loadc_a + l) * p.stride_a + loadr_a]);
            } else {
                buf_a_up[(loadc_a + l) * SHMEM_STRIDE + loadr_a] = FLOAT_TYPE(0.0f);
            }
#endif
#elif defined(DATA_A_BF16)
#if LOAD_VEC_A == 4
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + loadr_a * LOAD_VEC_A;
            buf_a_up[buf_idx    ] = TO_FLOAT_TYPE(data_a[idx].x);
            buf_a_up[buf_idx + 1] = TO_FLOAT_TYPE(data_a[idx].y);
            buf_a_up[buf_idx + 2] = TO_FLOAT_TYPE(data_a[idx].z);
            buf_a_up[buf_idx + 3] = TO_FLOAT_TYPE(data_a[idx].w);
            }
#else
            if (ir * BM + loadc_a + l < p.M && block + loadr_a < end_k) {
                buf_a_up[(loadc_a + l) * SHMEM_STRIDE + loadr_a] = TO_FLOAT_TYPE(data_a[pos_a_up + (loadc_a + l) * p.stride_a + loadr_a]);
            } else {
                buf_a_up[(loadc_a + l) * SHMEM_STRIDE + loadr_a] = TO_FLOAT_TYPE(uint16_t(0));
            }
#endif
#elif defined(DATA_A_Q4_0)
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + 4 * loadr_a;
            const uint ib = idx / 4;
            const uint iqs = idx & 0x03;
            const float d = float(data_a_packed16[ib].d);
            const uint vui = uint(data_a_packed16[ib].qs[2*iqs]) | (uint(data_a_packed16[ib].qs[2*iqs + 1]) << 16);
            const vec4 v0 = (vec4(unpack8(vui & 0x0F0F0F0F)) - 8.0f) * d;
            const vec4 v1 = (vec4(unpack8((vui >> 4) & 0x0F0F0F0F)) - 8.0f) * d;
            buf_a_up[buf_idx     ] = FLOAT_TYPE(v0.x);
            buf_a_up[buf_idx + 1 ] = FLOAT_TYPE(v0.y);
            buf_a_up[buf_idx + 2 ] = FLOAT_TYPE(v0.z);
            buf_a_up[buf_idx + 3 ] = FLOAT_TYPE(v0.w);
            buf_a_up[buf_idx + 16] = FLOAT_TYPE(v1.x);
            buf_a_up[buf_idx + 17] = FLOAT_TYPE(v1.y);
            buf_a_up[buf_idx + 18] = FLOAT_TYPE(v1.z);
            buf_a_up[buf_idx + 19] = FLOAT_TYPE(v1.w);
            }
#elif defined(DATA_A_Q4_1)
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + 4 * loadr_a;
            const uint ib = idx / 4;
            const uint iqs = idx & 0x03;
            const float d = float(data_a_packed16[ib].d);
            const float m = float(data_a_packed16[ib].m);
            const uint vui = uint(data_a_packed16[ib].qs[2*iqs]) | (uint(data_a_packed16[ib].qs[2*iqs + 1]) << 16);
            const vec4 v0 = vec4(unpack8(vui & 0x0F0F0F0F)) * d + m;
            const vec4 v1 = vec4(unpack8((vui >> 4) & 0x0F0F0F0F)) * d + m;
            buf_a_up[buf_idx     ] = FLOAT_TYPE(v0.x);
            buf_a_up[buf_idx + 1 ] = FLOAT_TYPE(v0.y);
            buf_a_up[buf_idx + 2 ] = FLOAT_TYPE(v0.z);
            buf_a_up[buf_idx + 3 ] = FLOAT_TYPE(v0.w);
            buf_a_up[buf_idx + 16] = FLOAT_TYPE(v1.x);
            buf_a_up[buf_idx + 17] = FLOAT_TYPE(v1.y);
            buf_a_up[buf_idx + 18] = FLOAT_TYPE(v1.z);
            buf_a_up[buf_idx + 19] = FLOAT_TYPE(v1.w);
            }
#elif defined(DATA_A_Q5_0)
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + 2 * loadr_a;
            const uint ib = idx / 8;
            const uint iqs = idx & 0x07;
            const float d = float(data_a_packed16[ib].d);
            const uint uint_qh = uint(data_a_packed16[ib].qh[1]) << 16 | uint(data_a_packed16[ib].qh[0]);
            const ivec2 qh0 = ivec2(((uint_qh >> 2*iqs) << 4) & 0x10, (uint_qh >> (2*iqs + 12)) & 0x10);
            const ivec2 qh1 = ivec2(((uint_qh >> (2*iqs + 1)) << 4) & 0x10, (uint_qh >> (2*iqs + 13)) & 0x10);
            const uint vui = uint(data_a_packed16[ib].qs[iqs]);
            const vec4 v = (vec4((vui & 0xF) | qh0.x, ((vui >> 4) & 0xF) | qh0.y, ((vui >> 8) & 0xF) | qh1.x, (vui >> 12) | qh1.y) - 16.0f) * d;
            buf_a_up[buf_idx     ] = FLOAT_TYPE(v.x);
            buf_a_up[buf_idx + 1 ] = FLOAT_TYPE(v.z);
            buf_a_up[buf_idx + 16] = FLOAT_TYPE(v.y);
            buf_a_up[buf_idx + 17] = FLOAT_TYPE(v.w);
            }
#elif defined(DATA_A_Q5_1)
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + 2 * loadr_a;
            const uint ib = idx / 8;
            const uint iqs = idx & 0x07;
            const float d = float(data_a_packed16[ib].d);
            const float m = float(data_a_packed16[ib].m);
            const uint uint_qh = data_a_packed16[ib].qh;
            const ivec2 qh0 = ivec2(((uint_qh >> 2*iqs) << 4) & 0x10, (uint_qh >> (2*iqs + 12)) & 0x10);
            const ivec2 qh1 = ivec2(((uint_qh >> (2*iqs + 1)) << 4) & 0x10, (uint_qh >> (2*iqs + 13)) & 0x10);
            const uint vui = uint(data_a_packed16[ib].qs[iqs]);
            const vec4 v = vec4((vui & 0xF) | qh0.x, ((vui >> 4) & 0xF) | qh0.y, ((vui >> 8) & 0xF) | qh1.x, (vui >> 12) | qh1.y) * d + m;
            buf_a_up[buf_idx     ] = FLOAT_TYPE(v.x);
            buf_a_up[buf_idx + 1 ] = FLOAT_TYPE(v.z);
            buf_a_up[buf_idx + 16] = FLOAT_TYPE(v.y);
            buf_a_up[buf_idx + 17] = FLOAT_TYPE(v.w);
            }
#elif defined(DATA_A_Q8_0)
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + loadr_a * LOAD_VEC_A;
            const uint ib = idx / 8;
            const uint iqs = idx & 0x07;
            const float d = float(data_a_packed16[ib].d);
            const i8vec2 v0 = unpack8(int32_t(data_a_packed16[ib].qs[2*iqs])).xy;
            const i8vec2 v1 = unpack8(int32_t(data_a_packed16[ib].qs[2*iqs + 1])).xy;
            const vec4 v = vec4(v0.x, v0.y, v1.x, v1.y) * d;
            buf_a_up[buf_idx    ] = FLOAT_TYPE(v.x);
            buf_a_up[buf_idx + 1] = FLOAT_TYPE(v.y);
            buf_a_up[buf_idx + 2] = FLOAT_TYPE(v.z);
            buf_a_up[buf_idx + 3] = FLOAT_TYPE(v.w);
            }
#elif defined(DATA_A_Q2_K)
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + loadr_a * LOAD_VEC_A;
            const uint ib = idx / 128;
            const uint iqs = idx % 128;
            const uint qsi = (iqs / 64) * 32 + (iqs % 16) * 2;
            const uint scalesi = iqs / 8;
            const uint qsshift = ((iqs % 64) / 16) * 2;
            const uvec2 qs = uvec2(data_a[ib].qs[qsi], data_a[ib].qs[qsi + 1]);
            const uint scales = data_a[ib].scales[scalesi];
            const vec2 d = vec2(data_a[ib].d);
            const vec2 v = d.x * float(scales & 0xF) * vec2((qs >> qsshift) & 3) - d.y * float(scales >> 4);
            buf_a_up[buf_idx    ] = FLOAT_TYPE(v.x);
            buf_a_up[buf_idx + 1] = FLOAT_TYPE(v.y);
            }
#elif defined(DATA_A_Q3_K)
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + loadr_a * LOAD_VEC_A;
            const uint ib = idx / 128;
            const uint iqs = idx % 128;
            const uint n = iqs / 64;
            const uint qsi = n * 32 + (iqs % 16) * 2;
            const uint hmi =          (iqs % 16) * 2;
            const uint j = (iqs % 64) / 4;
            const uint is = iqs / 8;
            const uint halfsplit = ((iqs % 64) / 16);
            const uint qsshift = halfsplit * 2;
            const uint m = 1 << (4 * n + halfsplit);
            const int8_t us = int8_t(((data_a[ib].scales[is % 8] >> (4 * int(is / 8))) & 0xF)
                                  | (((data_a[ib].scales[8 + (is % 4)] >> (2 * int(is / 4))) & 3) << 4));
            const float dl = float(data_a[ib].d) * float(us - 32);
            buf_a_up[buf_idx    ] = FLOAT_TYPE(dl * float(int8_t((data_a[ib].qs[qsi    ] >> qsshift) & 3) - (((data_a[ib].hmask[hmi    ] & m) != 0) ? 0 : 4)));
            buf_a_up[buf_idx + 1] = FLOAT_TYPE(dl * float(int8_t((data_a[ib].qs[qsi + 1] >> qsshift) & 3) - (((data_a[ib].hmask[hmi + 1] & m) != 0) ? 0 : 4)));
            }
#elif defined(DATA_A_Q4_K)
            {
            const uint idx = pos_a_up + (loadc_a + l) * p.stride_a / LOAD_VEC_A + loadr_a;
            const uint buf_idx = (loadc_a + l) * SHMEM_STRIDE + loadr_a * LOAD_VEC_A;
            const uint ib = idx / 128;
            const uint iqs = idx % 128;
            const uint n = iqs / 32;
            const uint b = (iqs % 32) / 16;
            const uint is = 2 * n + b;
            const uint qsi = n * 32 + (iqs % 16) * 2;
            const vec2 loadd = vec2(data_a[ib].d);
            const uint scidx0 = (is < 4) ? is : (is + 4);
            const uint scidx1 = (is < 4) ? is : (is - 4);
            const uint scidxmask1 = (is < 4) ? 0x30 : 0xC0;
            const uint scidxshift1 = (is < 4) ? 0 : 2;
            const uint mbidx0 = is + 4;
            const uint mbidx1 = (is < 4) ? is + 4 : is;
            const uint mbidxmask0 = (is < 4) ? 0xF : 0xF0;
            const uint mbidxshift0 = (is < 4) ? 0 : 4;
            const uint mbidxmask1 = (is < 4) ? 0x30 : 0xC0;
            const uint mbidxshift1 = (is < 4) ? 0 : 2;
            const uint8_t sc = uint8_t((data_a[ib].scales[scidx0] & 0xF) | ((data_a[ib].scales[scidx1] & scidxmask1) >> scidxshift1));
            const uint8_t mbyte = uint8_t((data_a[ib].scales[mbidx0] & mbidxmask0) >> mbidxshift0 | ((data_a[ib].scales[mbidx1] & mbidxmask1) >> mbidxshift1));
