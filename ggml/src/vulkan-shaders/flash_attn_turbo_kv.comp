#version 450

// Flash Attention with TURBO_KV_4B KV cache.
// Uses shared memory pre-dequantization via inverse RHT before
// the standard Q·K dot product and P·V accumulation phases.
// One subgroup handles one 128-element block's inverse transform.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#include "types.comp"
// Prevent flash_attn_base from declaring kv_packed[2] at binding 1 —
// TURBO_KV_4B uses separate K and V bindings with the block struct directly.
#undef A_TYPE_PACKED16
#include "flash_attn_base.comp"
#include "turbo_kv_4b_rht.comp"

const uint32_t HSK_per_thread = HSK / D_split;
const uint32_t HSV_per_thread = HSV / D_split;
const uint32_t cols_per_iter = WorkGroupSize / D_split;
const uint32_t cols_per_thread = Bc / cols_per_iter;

// KV block bindings (separate K and V for TURBO_KV_4B)
layout (binding = 0) readonly buffer Q {float data_q[];};
layout (binding = 0) readonly buffer QV4 {vec4 data_qv4[];};
layout (binding = 1) readonly buffer K_TKV {block_turbo_kv_4b data_k[];};
layout (binding = 2) readonly buffer V_TKV {block_turbo_kv_4b data_v[];};
layout (binding = 3) readonly buffer M {float16_t data_m[];};

D_TYPE perElemOpGqaStore(const in uint32_t r, const in uint32_t c, const in D_TYPE elem, const in uint32_t o_offset, const in uint32_t iq2, const in uint32_t N)
{
    uint32_t offset = (iq2 + r) * HSV + c;
    data_o[o_offset + offset] = D_TYPE(elem);
    return elem;
}

// Shared memory for pre-dequantized KV vectors and FA workspace
shared FLOAT_TYPE tmpsh[WorkGroupSize];
shared vec4 tmpshv4[WorkGroupSize];
shared float masksh[Bc][Br];
shared vec4 Qf[Br][HSK / 4];

// Pre-dequantized KV buffer: Bc tokens × max(HSK, HSV) elements
// With HSK=HSV=256 and Bc=32: 32*256*4 = 32 KB
shared float kv_sh[Bc * HSK];

// Dequantize one 128-element TURBO_KV_4B block into shared memory.
// Each subgroup (wave32 or wave64) handles one block.
void dequant_turbo_block_to_shared(
    uint block_idx,     // block index in the source buffer
    uint sh_base,       // base offset in kv_sh[] for output
    uint sub_tid,       // subgroup-local thread ID
    float norm,         // block norm
    float rcp_inv_std,  // 1/inv_std for unscaling
    bool is_k           // true for K buffer, false for V buffer
) {
#if SUBGROUP_SIZE >= 64
    uint byte0_idx = sub_tid / 2;
    uint byte1_idx = (sub_tid + 64) / 2;

    uint byte0 = is_k ? uint(data_k[block_idx].mse_indices[byte0_idx])
                       : uint(data_v[block_idx].mse_indices[byte0_idx]);
    uint byte1 = is_k ? uint(data_k[block_idx].mse_indices[byte1_idx])
                       : uint(data_v[block_idx].mse_indices[byte1_idx]);

    float val0 = turbo_kv_unpack_byte(byte0, sub_tid,      rcp_inv_std);
    float val1 = turbo_kv_unpack_byte(byte1, sub_tid + 64,  rcp_inv_std);

    turbo_kv_inverse_rht(val0, val1, sub_tid, norm);

    kv_sh[sh_base + sub_tid]      = val0;
    kv_sh[sh_base + sub_tid + 64] = val1;
#else
    uint byte0_idx = sub_tid / 2;
    uint byte1_idx = (sub_tid + 32) / 2;
    uint byte2_idx = (sub_tid + 64) / 2;
    uint byte3_idx = (sub_tid + 96) / 2;

    uint b0 = is_k ? uint(data_k[block_idx].mse_indices[byte0_idx])
                    : uint(data_v[block_idx].mse_indices[byte0_idx]);
    uint b1 = is_k ? uint(data_k[block_idx].mse_indices[byte1_idx])
                    : uint(data_v[block_idx].mse_indices[byte1_idx]);
    uint b2 = is_k ? uint(data_k[block_idx].mse_indices[byte2_idx])
                    : uint(data_v[block_idx].mse_indices[byte2_idx]);
    uint b3 = is_k ? uint(data_k[block_idx].mse_indices[byte3_idx])
                    : uint(data_v[block_idx].mse_indices[byte3_idx]);

    float v0 = turbo_kv_unpack_byte(b0, sub_tid,      rcp_inv_std);
    float v1 = turbo_kv_unpack_byte(b1, sub_tid + 32,  rcp_inv_std);
    float v2 = turbo_kv_unpack_byte(b2, sub_tid + 64,  rcp_inv_std);
    float v3 = turbo_kv_unpack_byte(b3, sub_tid + 96,  rcp_inv_std);

    turbo_kv_inverse_rht(v0, v1, v2, v3, sub_tid, norm);

    kv_sh[sh_base + sub_tid]      = v0;
    kv_sh[sh_base + sub_tid + 32] = v1;
    kv_sh[sh_base + sub_tid + 64] = v2;
    kv_sh[sh_base + sub_tid + 96] = v3;
#endif
}

void main() {
    init_indices();

    const uint32_t tid = gl_LocalInvocationIndex;
    const uint32_t d_tid = tid % D_split;
    const uint32_t col_tid = tid / D_split;
    const uint32_t sub_id = gl_SubgroupID;
    const uint32_t sub_tid = gl_SubgroupInvocationID;
    const uint32_t n_subgroups = gl_NumSubgroups;

    uint32_t q_offset = (iq2*p.nb02+iq3*p.nb03) / 4;

    // Load Q into shared memory
    [[unroll]] for (uint32_t idx = 0; idx < Br * HSK / 4; idx += gl_WorkGroupSize.x) {
        uint32_t d = (idx + tid) % (HSK / 4);
        uint32_t r = (idx + tid) / (HSK / 4);
        if (r < Br && d < HSK / 4 && i * Br + r < N) {
            Qf[r][d] = vec4(data_qv4[q_offset / 4 + (i * Br + r) * q_stride / 4 + d]) * p.scale;
        }
    }
    barrier();

    vec4 Of[Br][HSV_per_thread / 4];
    [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            Of[r][d] = vec4(0.0);
        }
    }

    float Lf[Br], Mf[Br];
    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);
    [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
        Lf[r] = 0;
        Mf[r] = NEG_FLT_MAX_OVER_2;
    }

    float slope[Br];
    [[unroll]] for (uint32_t r = 0; r < Br; ++r) { slope[r] = 1.0; }
    if (p.max_bias > 0.0f) {
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            slope[r] = perElemOpComputeSlope(r, col_tid, ACC_TYPE(0), iq2);
        }
    }

    // KV offsets: in TURBO_KV_4B block units
    // Each block = 128 elements. For a KV row of D elements, there are D/128 blocks per row.
    const uint32_t blocks_per_row = HSK / QUANT_K_TURBO_KV_4B;
    uint32_t k_row_offset = ik2 * (p.nb12 / 72) + ik3 * (p.nb13 / 72);  // 72 bytes per block
    uint32_t v_row_offset = iv2 * (p.nb22 / 72) + iv3 * (p.nb23 / 72);

    uint32_t m_offset = 0;
    if (p.nem2 != 1 || p.nem3 != 1) {
        m_offset = ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
    }

    [[dont_unroll]]
    for (uint32_t j = start_j; j < end_j; ++j) {

        // ===================== Phase 1: Dequant K into shared memory =====================
        // Dequant Bc KV tokens × blocks_per_row blocks each
        for (uint32_t token_base = 0; token_base < Bc; token_base += n_subgroups) {
            uint32_t token_idx = token_base + sub_id;
            uint32_t kv_token = j * Bc + token_idx;

            if (token_idx < Bc && kv_token < KV) {
                for (uint32_t blk = 0; blk < blocks_per_row; blk++) {
                    uint32_t block_idx = k_row_offset + kv_token * blocks_per_row + blk;
                    float norm = unpackHalf2x16(uint(data_k[block_idx].norm)).x;
                    float inv_std = unpackHalf2x16(uint(data_k[block_idx].inv_std_fp16)).x;
                    float rcp = 1.0 / max(inv_std, 1e-10);

                    dequant_turbo_block_to_shared(
                        block_idx,
                        token_idx * HSK + blk * QUANT_K_TURBO_KV_4B,
                        sub_tid, norm, rcp, true
                    );
                }
            }
        }
        barrier();

        // ===================== Phase 2: Q·K dot product from shared memory =====================
        float Sf[Br][cols_per_thread];
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                Sf[r][c] = 0.0;
            }
        }

        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            uint32_t kv_col = c * cols_per_iter + col_tid;
            [[unroll]] for (uint32_t d = 0; d < HSK_per_thread / 4; ++d) {
                uint32_t elem_base = 4 * (d * D_split + d_tid);
                vec4 K_Tf = vec4(
                    kv_sh[kv_col * HSK + elem_base + 0],
                    kv_sh[kv_col * HSK + elem_base + 1],
                    kv_sh[kv_col * HSK + elem_base + 2],
                    kv_sh[kv_col * HSK + elem_base + 3]
                );
                [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                    Sf[r][c] += dot(Qf[r][d * D_split + d_tid], K_Tf);
                }
            }
        }

        // D_split reduction
        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            [[unroll]] for (uint s = D_split / 2; s > 0; s >>= 1) {
                [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                    Sf[r][c] += subgroupShuffleXor(Sf[r][c], s);
                }
            }
        }

        if (p.logit_softcap != 0.0f) {
            [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                    Sf[r][c] = p.logit_softcap * tanh(Sf[r][c]);
                }
            }
        }

        if ((p.mask_n_head_log2 & MASK_ENABLE_BIT) != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) % Bc;
                uint32_t r = (idx + tid) / Bc;
                if (idx + tid < Bc * Br) {
                    masksh[c][r] = float(data_m[m_offset + (i * Br + r) * m_stride + (j * Bc + c)]);
                }
            }
            barrier();

            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                    Sf[r][c] += slope[r] * masksh[c * cols_per_iter + col_tid][r];
                }
            }
            barrier();
        }

        // Softmax
        float rowmaxf[Br], Pf[Br][cols_per_thread], rowsumf[Br], eMf[Br], Moldf[Br];
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            rowmaxf[r] = Sf[r][0];
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                rowmaxf[r] = max(rowmaxf[r], Sf[r][c]);
            }
            Moldf[r] = Mf[r];
            Mf[r] = max(rowmaxf[r], Moldf[r]);
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                Pf[r][c] = exp(Sf[r][c] - Mf[r]);
            }
            eMf[r] = exp(Moldf[r] - Mf[r]);
            rowsumf[r] = 0.0;
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                rowsumf[r] += Pf[r][c];
            }
            Lf[r] = eMf[r]*Lf[r] + rowsumf[r];
        }

        [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
            [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                Of[r][d] = eMf[r] * Of[r][d];
            }
        }

        // ===================== Phase 3: Dequant V into shared memory =====================
        barrier();
        for (uint32_t token_base = 0; token_base < Bc; token_base += n_subgroups) {
            uint32_t token_idx = token_base + sub_id;
            uint32_t kv_token = j * Bc + token_idx;

            if (token_idx < Bc && kv_token < KV) {
                for (uint32_t blk = 0; blk < blocks_per_row; blk++) {
                    uint32_t block_idx = v_row_offset + kv_token * blocks_per_row + blk;
                    float norm = unpackHalf2x16(uint(data_v[block_idx].norm)).x;
                    float inv_std = unpackHalf2x16(uint(data_v[block_idx].inv_std_fp16)).x;
                    float rcp = 1.0 / max(inv_std, 1e-10);

                    dequant_turbo_block_to_shared(
                        block_idx,
                        token_idx * HSV + blk * QUANT_K_TURBO_KV_4B,
                        sub_tid, norm, rcp, false
                    );
                }
            }
        }
        barrier();

        // ===================== Phase 4: P·V accumulation from shared memory =====================
        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            uint32_t kv_col = c * cols_per_iter + col_tid;
            [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
                uint32_t elem_base = 4 * (d * D_split + d_tid);
                vec4 Vf = vec4(
                    kv_sh[kv_col * HSV + elem_base + 0],
                    kv_sh[kv_col * HSV + elem_base + 1],
                    kv_sh[kv_col * HSV + elem_base + 2],
                    kv_sh[kv_col * HSV + elem_base + 3]
                );
                [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                    Of[r][d] += Pf[r][c] * Vf;
                }
            }
        }

        barrier();
    }

    // ===================== Final reduction and output (same as standard flash_attn) =====================
    [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
        float rowmaxf, eMf;

        tmpsh[tid] = Mf[r];
        barrier();
        [[unroll]] for (int s = int(gl_WorkGroupSize.x) / 2; s >= D_split; s >>= 1) {
            if (tid < s) { tmpsh[tid] = max(tmpsh[tid], tmpsh[tid + s]); }
            barrier();
        }
        rowmaxf = tmpsh[d_tid];
        barrier();

        float Moldf = Mf[r];
        Mf[r] = max(rowmaxf, Moldf);
        eMf = exp(Moldf - Mf[r]);
        Lf[r] = eMf*Lf[r];

        tmpsh[tid] = Lf[r];
        barrier();
        [[unroll]] for (int s = int(gl_WorkGroupSize.x) / 2; s >= D_split; s >>= 1) {
            if (tid < s) { tmpsh[tid] = tmpsh[tid] + tmpsh[tid + s]; }
            barrier();
        }
        Lf[r] = tmpsh[d_tid];
        barrier();

        [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
            Of[r][d] = eMf * Of[r][d];
            tmpshv4[tid] = Of[r][d];
            barrier();
            [[unroll]] for (int s = int(gl_WorkGroupSize.x) / 2; s >= D_split; s >>= 1) {
                if (tid < s) { Of[r][d] += tmpshv4[tid + s]; tmpshv4[tid] = Of[r][d]; }
                barrier();
            }
            Of[r][d] = tmpshv4[d_tid];
            barrier();
        }
    }

    // Output
    if (p.k_num > 1) {
        uint32_t o_offset = HSV * p.ne1 * (split_k_index + iq3 * p.k_num);
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            if (r < N) {
                [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
                    [[unroll]] for (uint32_t comp = 0; comp < 4; ++comp) {
                        perElemOpGqaStore(r, 4*(d * D_split + d_tid) + comp, Of[r][d][comp], o_offset, iq2, N);
                    }
                }
            }
        }
        o_offset = HSV * p.ne1 * p.ne3 * p.k_num + p.ne1 * (split_k_index + iq3 * p.k_num) * 2;
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            if (r < N) {
                perElemOpStoreCol0(r, 0u, ACC_TYPE(Lf[r]), o_offset, iq2, N);
                perElemOpStoreCol0(r, 0u, ACC_TYPE(Mf[r]), o_offset + p.ne1, iq2, N);
            }
        }
        return;
    }

    float Lfrcp[Br];
    [[unroll]] for (uint32_t r = 0; r < Br; ++r) { Lfrcp[r] = 1.0 / Lf[r]; }

    [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            Of[r][d] *= Lfrcp[r];
        }
    }

    uint32_t o_offset = iq3*p.ne2*p.ne1*HSV;
    if (p.gqa_ratio > 1) {
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            if (r < N) {
                [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
                    [[unroll]] for (uint32_t comp = 0; comp < 4; ++comp) {
                        perElemOpGqaStore(r, 4*(d * D_split + d_tid) + comp, Of[r][d][comp], o_offset, iq2, N);
                    }
                }
            }
        }
    } else {
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            if (i * Br + r < N) {
                [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
                    [[unroll]] for (uint32_t comp = 0; comp < 4; ++comp) {
                        data_o[o_offset + iq2 * HSV + (i * Br + r) * p.ne1 * HSV + 4*(d * D_split + d_tid) + comp] = D_TYPE(Of[r][d][comp]);
                    }
                }
            }
        }
    }
}
