#version 450

// Flash Attention with TURBO_KV_4B KV cache.
// Uses shared memory pre-dequantization via inverse RHT before
// the standard Q·K dot product and P·V accumulation phases.
// One subgroup handles one 128-element block's inverse transform.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#include "types.comp"
#include "flash_attn_base.comp"
#include "turbo_kv_4b_rht.comp"

const uint32_t HSK_per_thread = HSK / D_split;
const uint32_t HSV_per_thread = HSV / D_split;
const uint32_t cols_per_iter = WorkGroupSize / D_split;
const uint32_t cols_per_thread = Bc / cols_per_iter;

// Standard FA binding layout: Q at 0, kv_packed[2] at 1, M at 3, O at 4
// Also alias kv_packed as non-packed struct for direct byte access in RHT dequant
layout (binding = 0) readonly buffer Q {float data_q[];};
layout (binding = 0) readonly buffer QV4 {vec4 data_qv4[];};
layout (binding = 1) readonly buffer KV_NONPACKED {block_turbo_kv_4b data_kv_np[];} kv_np[2];
layout (binding = 3) readonly buffer M {float16_t data_m[];};

D_TYPE perElemOpGqaStore(const in uint32_t r, const in uint32_t c, const in D_TYPE elem, const in uint32_t o_offset, const in uint32_t iq2, const in uint32_t N)
{
    uint32_t offset = (iq2 + r) * HSV + c;
    data_o[o_offset + offset] = D_TYPE(elem);
    return elem;
}

// Shared memory for pre-dequantized KV vectors and FA workspace
shared FLOAT_TYPE tmpsh[WorkGroupSize];
shared vec4 tmpshv4[WorkGroupSize];
shared float masksh[Bc][Br];
shared vec4 Qf[Br][HSK / 4];

// Pre-dequantized KV buffer: Bc tokens × max(HSK, HSV) elements
// With HSK=HSV=256 and Bc=32: 32*256*4 = 32 KB
shared float kv_sh[Bc * HSK];

// FWHT scratch for out-of-place butterfly
shared float fwht_tmp[QUANT_K_TURBO_KV_4B];

// No separate function — NIR inlines and optimizes through it anyway.

// Dequant one 128-element block: codebook lookup with per-block scaling.
// For K: includes norm factor so Q_rot · K_stored = Q · K (not Q · K/norm).
// bind_idx: 0 for K buffer, 1 for V buffer.
void dequant_block_codebook_to_shared(
    uint block_idx, uint sh_base, uint sub_tid, float scale, uint bind_idx
) {
    for (uint elem = sub_tid; elem < QUANT_K_TURBO_KV_4B; elem += gl_SubgroupSize) {
        uint byte_idx = elem / 2;
        uint byte_val = uint(kv_np[bind_idx].data_kv_np[block_idx].mse_indices[byte_idx]);
        uint nibble = ((elem & 1u) == 0u) ? (byte_val & 0xFu) : ((byte_val >> 4) & 0xFu);
        kv_sh[sh_base + elem] = TURBO_KV_CODEBOOK[nibble] * scale;
    }
}

// Dequant KV block: full inverse RHT to original domain via subgroup-cooperative FWHT.
// bind_idx: 0 for K, 1 for V.
void dequant_block_rht_to_shared(
    uint block_idx, uint sh_base, uint sub_tid, float norm, float rcp_inv_std, uint bind_idx
) {
#if SUBGROUP_SIZE >= 64
    uint byte_idx0 = sub_tid / 2;
    uint byte_idx1 = (sub_tid + 64) / 2;
    uint byte0 = uint(kv_np[bind_idx].data_kv_np[block_idx].mse_indices[byte_idx0]);
    uint byte1 = uint(kv_np[bind_idx].data_kv_np[block_idx].mse_indices[byte_idx1]);
    float val0 = turbo_kv_unpack_byte(byte0, sub_tid,      rcp_inv_std);
    float val1 = turbo_kv_unpack_byte(byte1, sub_tid + 64,  rcp_inv_std);
    turbo_kv_inverse_rht(val0, val1, sub_tid, norm);
    kv_sh[sh_base + sub_tid]      = val0;
    kv_sh[sh_base + sub_tid + 64] = val1;
#else
    uint bi0 = sub_tid / 2;
    uint bi1 = (sub_tid + 32) / 2;
    uint bi2 = (sub_tid + 64) / 2;
    uint bi3 = (sub_tid + 96) / 2;
    uint b0 = uint(kv_np[bind_idx].data_kv_np[block_idx].mse_indices[bi0]);
    uint b1 = uint(kv_np[bind_idx].data_kv_np[block_idx].mse_indices[bi1]);
    uint b2 = uint(kv_np[bind_idx].data_kv_np[block_idx].mse_indices[bi2]);
    uint b3 = uint(kv_np[bind_idx].data_kv_np[block_idx].mse_indices[bi3]);
    float v0 = turbo_kv_unpack_byte(b0, sub_tid,      rcp_inv_std);
    float v1 = turbo_kv_unpack_byte(b1, sub_tid + 32,  rcp_inv_std);
    float v2 = turbo_kv_unpack_byte(b2, sub_tid + 64,  rcp_inv_std);
    float v3 = turbo_kv_unpack_byte(b3, sub_tid + 96,  rcp_inv_std);
    turbo_kv_inverse_rht(v0, v1, v2, v3, sub_tid, norm);
    kv_sh[sh_base + sub_tid]      = v0;
    kv_sh[sh_base + sub_tid + 32] = v1;
    kv_sh[sh_base + sub_tid + 64] = v2;
    kv_sh[sh_base + sub_tid + 96] = v3;
#endif
}

void main() {
    init_indices();

    const uint32_t tid = gl_LocalInvocationIndex;
    const uint32_t d_tid = tid % D_split;

    const uint32_t col_tid = tid / D_split;
    const uint32_t sub_id = gl_SubgroupID;
    const uint32_t sub_tid = gl_SubgroupInvocationID;
    const uint32_t n_subgroups = gl_NumSubgroups;

    uint32_t q_offset = (iq2*p.nb02+iq3*p.nb03) / 4;

    // Load Q into shared memory and apply per-block forward RHT.
    // TurboQuant computes scores as RHT(Q) · K_stored, exploiting dot-product preservation.
    // The rotation is: per element, sign(elem) * x, then FWHT, then scale 1/√128.
    // We use kv_sh[] as scratch for the per-element FWHT butterfly.

    // Step 1: Load Q into Qf[] (unrotated)
    [[unroll]] for (uint32_t idx = 0; idx < Br * HSK / 4; idx += gl_WorkGroupSize.x) {
        uint32_t d = (idx + tid) % (HSK / 4);
        uint32_t r = (idx + tid) / (HSK / 4);
        if (r < Br && d < HSK / 4 && i * Br + r < N) {
            Qf[r][d] = vec4(data_qv4[q_offset / 4 + (i * Br + r) * q_stride / 4 + d]) * p.scale;
        }
    }
    barrier();

    // Step 2: Forward-RHT each 128-element block of Q via kv_sh scratch.
    for (uint32_t r = 0; r < Br; r++) {
        if (i * Br + r >= N) continue;

        // Read Q as full vec4s (avoid component access overhead)
        for (uint32_t d = tid; d < HSK / 4; d += WorkGroupSize) {
            vec4 q = Qf[r][d];
            kv_sh[d*4+0] = q.x;
            kv_sh[d*4+1] = q.y;
            kv_sh[d*4+2] = q.z;
            kv_sh[d*4+3] = q.w;
        }
        barrier();

        for (uint32_t blk = 0; blk < HSK / QUANT_K_TURBO_KV_4B; blk++) {
            uint32_t base = blk * QUANT_K_TURBO_KV_4B;
            for (uint32_t idx = tid; idx < QUANT_K_TURBO_KV_4B; idx += WorkGroupSize) {
                kv_sh[base + idx] *= turbo_kv_sign(idx);
            }
            barrier();
            for (uint32_t s = 1; s < QUANT_K_TURBO_KV_4B; s <<= 1) {
                // Copy to scratch for out-of-place read
                for (uint32_t idx = tid; idx < QUANT_K_TURBO_KV_4B; idx += WorkGroupSize) {
                    fwht_tmp[idx] = kv_sh[base + idx];
                }
                barrier();
                // Butterfly: read from scratch, write to kv_sh.
                // Use branchless form to prevent ACO from merging the add/sub branches.
                for (uint32_t idx = tid; idx < QUANT_K_TURBO_KV_4B; idx += WorkGroupSize) {
                    uint32_t partner = idx ^ s;
                    float a = fwht_tmp[idx];
                    float b = fwht_tmp[partner];
                    // sign = +1 for low half (idx & s == 0), -1 for high half
                    float sign = ((idx & s) == 0u) ? 1.0 : -1.0;
                    kv_sh[base + idx] = b + sign * a;
                }
                barrier();
            }
            for (uint32_t idx = tid; idx < QUANT_K_TURBO_KV_4B; idx += WorkGroupSize) {
                kv_sh[base + idx] *= TURBO_KV_RSQRT128;
            }
            barrier();
        }

        // Write rotated Q back as full vec4s (avoid component write race)
        for (uint32_t d = tid; d < HSK / 4; d += WorkGroupSize) {
            Qf[r][d] = vec4(kv_sh[d*4], kv_sh[d*4+1], kv_sh[d*4+2], kv_sh[d*4+3]);
        }
        barrier();
    }

    vec4 Of[Br][HSV_per_thread / 4];
    [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            Of[r][d] = vec4(0.0);
        }
    }

    float Lf[Br], Mf[Br];
    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);
    [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
        Lf[r] = 0;
        Mf[r] = NEG_FLT_MAX_OVER_2;
    }

    float slope[Br];
    [[unroll]] for (uint32_t r = 0; r < Br; ++r) { slope[r] = 1.0; }
    if (p.max_bias > 0.0f) {
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            slope[r] = perElemOpComputeSlope(r, col_tid, ACC_TYPE(0), iq2);
        }
    }

    // KV offsets: in TURBO_KV_4B block units (72 bytes per block)
    const uint32_t blocks_per_row = HSK / QUANT_K_TURBO_KV_4B;
    // nb12/nb13 are byte strides for dims 2/3. Divide by block byte size (72) to get block offsets.
    uint32_t k_row_offset = (ik2*p.nb12 + ik3*p.nb13) / 72;
    uint32_t v_row_offset = (iv2*p.nb22 + iv3*p.nb23) / 72;

    uint32_t m_offset = 0;
    if (p.nem2 != 1 || p.nem3 != 1) {
        m_offset = ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
    }

    [[dont_unroll]]
    for (uint32_t j = start_j; j < end_j; ++j) {

        // ===================== Phase 1: Dequant K into shared memory =====================
        // Zero kv_sh first — positions beyond KV won't be dequanted but the
        // attention mask might not fully prevent 0*NaN = NaN in P·V accumulation.
        for (uint32_t idx = tid; idx < Bc * HSK; idx += WorkGroupSize) {
            kv_sh[idx] = 0.0;
        }
        barrier();

        // Dequant K: codebook × norm/inv_std (no inverse RHT — Q is rotated)
        for (uint32_t token_base = 0; token_base < Bc; token_base += n_subgroups) {
            uint32_t token_idx = token_base + sub_id;
            uint32_t kv_token = j * Bc + token_idx;

            if (token_idx < Bc && kv_token < KV) {
                for (uint32_t blk = 0; blk < blocks_per_row; blk++) {
                    uint32_t block_idx = k_row_offset + kv_token * blocks_per_row + blk;
                    float norm = unpackHalf2x16(uint(kv_np[0].data_kv_np[block_idx].norm)).x;
                    float inv_std = unpackHalf2x16(uint(kv_np[0].data_kv_np[block_idx].inv_std_fp16)).x;
                    float rcp = 1.0 / max(inv_std, 1e-10);

                    // K scale includes norm: Q_rot · (codebook/inv_std * norm) = Q · K
                    dequant_block_codebook_to_shared(
                        block_idx,
                        token_idx * HSK + blk * QUANT_K_TURBO_KV_4B,
                        sub_tid, rcp * norm, 0
                    );
                }
            }
        }

        // ===================== Phase 2: Q·K dot product from shared memory =====================
        float Sf[Br][cols_per_thread];
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                Sf[r][c] = 0.0;
            }
        }

        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            uint32_t kv_col = c * cols_per_iter + col_tid;
            [[unroll]] for (uint32_t d = 0; d < HSK_per_thread / 4; ++d) {
                uint32_t elem_base = 4 * (d * D_split + d_tid);
                vec4 K_Tf = vec4(
                    kv_sh[kv_col * HSK + elem_base + 0],
                    kv_sh[kv_col * HSK + elem_base + 1],
                    kv_sh[kv_col * HSK + elem_base + 2],
                    kv_sh[kv_col * HSK + elem_base + 3]
                );
                [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                    Sf[r][c] += dot(Qf[r][d * D_split + d_tid], K_Tf);
                }
            }
        }

        // D_split reduction
        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            [[unroll]] for (uint s = D_split / 2; s > 0; s >>= 1) {
                [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                    Sf[r][c] += subgroupShuffleXor(Sf[r][c], s);
                }
            }
        }

        if (p.logit_softcap != 0.0f) {
            [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                    Sf[r][c] = p.logit_softcap * tanh(Sf[r][c]);
                }
            }
        }

        if ((p.mask_n_head_log2 & MASK_ENABLE_BIT) != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) % Bc;
                uint32_t r = (idx + tid) / Bc;
                if (idx + tid < Bc * Br) {
                    masksh[c][r] = float(data_m[m_offset + (i * Br + r) * m_stride + (j * Bc + c)]);
                }
            }
            barrier();

            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                    Sf[r][c] += slope[r] * masksh[c * cols_per_iter + col_tid][r];
                }
            }
            barrier();
        }

        // Softmax
        float rowmaxf[Br], Pf[Br][cols_per_thread], rowsumf[Br], eMf[Br], Moldf[Br];
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            rowmaxf[r] = Sf[r][0];
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                rowmaxf[r] = max(rowmaxf[r], Sf[r][c]);
            }
            Moldf[r] = Mf[r];
            Mf[r] = max(rowmaxf[r], Moldf[r]);
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                Pf[r][c] = exp(Sf[r][c] - Mf[r]);
            }
            eMf[r] = exp(Moldf[r] - Mf[r]);
            rowsumf[r] = 0.0;
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                rowsumf[r] += Pf[r][c];
            }
            Lf[r] = eMf[r]*Lf[r] + rowsumf[r];
        }

        [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
            [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                Of[r][d] = eMf[r] * Of[r][d];
            }
        }

        // ===================== Phase 3: Dequant V — codebook then shmem FWHT =====================
        barrier();
        for (uint32_t idx = tid; idx < Bc * HSV; idx += WorkGroupSize) {
            kv_sh[idx] = 0.0;
        }
        barrier();

        // V codebook write then shmem inverse RHT
        for (uint32_t token_base = 0; token_base < Bc; token_base += n_subgroups) {
            uint32_t token_idx = token_base + sub_id;
            uint32_t kv_token = j * Bc + token_idx;
            if (token_idx < Bc && kv_token < KV) {
                for (uint32_t blk = 0; blk < blocks_per_row; blk++) {
                    uint32_t block_idx = v_row_offset + kv_token * blocks_per_row + blk;
                    float inv_std = unpackHalf2x16(uint(kv_np[1].data_kv_np[block_idx].inv_std_fp16)).x;
                    float rcp = 1.0 / max(inv_std, 1e-10);
                    dequant_block_codebook_to_shared(
                        block_idx, token_idx * HSV + blk * QUANT_K_TURBO_KV_4B,
                        sub_tid, rcp, 1);
                }
            }
        }
        barrier();
        for (uint32_t token_base = 0; token_base < Bc; token_base++) {
            uint32_t kv_token = j * Bc + token_base;
            if (kv_token >= KV) continue;
            for (uint32_t blk = 0; blk < HSV / QUANT_K_TURBO_KV_4B; blk++) {
                uint32_t base = token_base * HSV + blk * QUANT_K_TURBO_KV_4B;
                for (uint32_t s = 1; s < QUANT_K_TURBO_KV_4B; s <<= 1) {
                    for (uint32_t idx = tid; idx < QUANT_K_TURBO_KV_4B; idx += WorkGroupSize) {
                        fwht_tmp[idx] = kv_sh[base + idx];
                    }
                    barrier();
                    for (uint32_t idx = tid; idx < QUANT_K_TURBO_KV_4B; idx += WorkGroupSize) {
                        uint32_t partner = idx ^ s;
                        // Use volatile reads to prevent NIR from optimizing
                        // the subtraction into addition (Mesa bug: NIR eliminates
                        // fsub in FWHT butterfly inside hot loops)
                        volatile float a = fwht_tmp[idx];
                        volatile float b = fwht_tmp[partner];
                        if ((idx & s) == 0u) {
                            kv_sh[base + idx] = a + b;
                        } else {
                            kv_sh[base + idx] = b - a;
                        }
                    }
                    barrier();
                }
                uint32_t block_idx = v_row_offset + kv_token * (HSV / QUANT_K_TURBO_KV_4B) + blk;
                float norm = unpackHalf2x16(uint(kv_np[1].data_kv_np[block_idx].norm)).x;
                float vscale = norm * TURBO_KV_RSQRT128;
                for (uint32_t idx = tid; idx < QUANT_K_TURBO_KV_4B; idx += WorkGroupSize) {
                    kv_sh[base + idx] *= turbo_kv_sign(idx) * vscale;
                }
                barrier();
            }
        }

        // ===================== Phase 4: P·V accumulation from shared memory =====================
        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            uint32_t kv_col = c * cols_per_iter + col_tid;
            [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
                uint32_t elem_base = 4 * (d * D_split + d_tid);
                vec4 Vf = vec4(
                    kv_sh[kv_col * HSV + elem_base + 0],
                    kv_sh[kv_col * HSV + elem_base + 1],
                    kv_sh[kv_col * HSV + elem_base + 2],
                    kv_sh[kv_col * HSV + elem_base + 3]
                );
                [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
                    Of[r][d] += Pf[r][c] * Vf;
                }
            }
        }

        barrier();
    }

    // ===================== Final reduction and output (same as standard flash_attn) =====================
    [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
        float rowmaxf, eMf;

        tmpsh[tid] = Mf[r];
        barrier();
        [[unroll]] for (int s = int(gl_WorkGroupSize.x) / 2; s >= D_split; s >>= 1) {
            if (tid < s) { tmpsh[tid] = max(tmpsh[tid], tmpsh[tid + s]); }
            barrier();
        }
        rowmaxf = tmpsh[d_tid];
        barrier();

        float Moldf = Mf[r];
        Mf[r] = max(rowmaxf, Moldf);
        eMf = exp(Moldf - Mf[r]);
        Lf[r] = eMf*Lf[r];

        tmpsh[tid] = Lf[r];
        barrier();
        [[unroll]] for (int s = int(gl_WorkGroupSize.x) / 2; s >= D_split; s >>= 1) {
            if (tid < s) { tmpsh[tid] = tmpsh[tid] + tmpsh[tid + s]; }
            barrier();
        }
        Lf[r] = tmpsh[d_tid];
        barrier();

        [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
            Of[r][d] = eMf * Of[r][d];
            tmpshv4[tid] = Of[r][d];
            barrier();
            [[unroll]] for (int s = int(gl_WorkGroupSize.x) / 2; s >= D_split; s >>= 1) {
                if (tid < s) { Of[r][d] += tmpshv4[tid + s]; tmpshv4[tid] = Of[r][d]; }
                barrier();
            }
            Of[r][d] = tmpshv4[d_tid];
            barrier();
        }
    }

    // Output
    if (p.k_num > 1) {
        uint32_t o_offset = HSV * p.ne1 * (split_k_index + iq3 * p.k_num);
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            if (r < N) {
                [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
                    [[unroll]] for (uint32_t comp = 0; comp < 4; ++comp) {
                        perElemOpGqaStore(r, 4*(d * D_split + d_tid) + comp, Of[r][d][comp], o_offset, iq2, N);
                    }
                }
            }
        }
        o_offset = HSV * p.ne1 * p.ne3 * p.k_num + p.ne1 * (split_k_index + iq3 * p.k_num) * 2;
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            if (r < N) {
                perElemOpStoreCol0(r, 0u, ACC_TYPE(Lf[r]), o_offset, iq2, N);
                perElemOpStoreCol0(r, 0u, ACC_TYPE(Mf[r]), o_offset + p.ne1, iq2, N);
            }
        }
        return;
    }

    float Lfrcp[Br];
    [[unroll]] for (uint32_t r = 0; r < Br; ++r) { Lfrcp[r] = 1.0 / Lf[r]; }

    [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            Of[r][d] *= Lfrcp[r];
        }
    }

    uint32_t o_offset = iq3*p.ne2*p.ne1*HSV;
    if (p.gqa_ratio > 1) {
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            if (r < N) {
                [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
                    [[unroll]] for (uint32_t comp = 0; comp < 4; ++comp) {
                        perElemOpGqaStore(r, 4*(d * D_split + d_tid) + comp, Of[r][d][comp], o_offset, iq2, N);
                    }
                }
            }
        }
    } else {
        [[unroll]] for (uint32_t r = 0; r < Br; ++r) {
            if (i * Br + r < N) {
                [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
                    [[unroll]] for (uint32_t comp = 0; comp < 4; ++comp) {
                        data_o[o_offset + iq2 * HSV + (i * Br + r) * p.ne1 * HSV + 4*(d * D_split + d_tid) + comp] = D_TYPE(Of[r][d][comp]);
                    }
                }
            }
        }
    }
}
